{
  "youtube": {
    "triggers": [
      "youtube extraction",
      "extract from youtube",
      "youtube video",
      "/youtube"
    ],
    "patterns": [
      "\\bhttps?://(?:www\\.)?youtube\\.com/watch\\?v=[\\w-]+",
      "\\bhttps?://youtu\\.be/[\\w-]+",
      "/youtube"
    ],
    "description": "Orchestrated YouTube extraction with model detection and checkpoints (primary)"
  },
  "generate-from-youtube": {
    "triggers": [
      "generate from youtube",
      "convert this video",
      "from this youtube",
      "learn from this video",
      "create from video",
      "youtube strategy",
      "youtube indicator",
      "trading video"
    ],
    "patterns": [
      "generate.*youtube",
      "youtube.*strategy",
      "youtube.*indicator",
      "convert.*video",
      "from.*youtube"
    ],
    "description": "Legacy YouTube extraction - prefer /youtube for new extractions"
  },
  "implement-strategy": {
    "triggers": [
      "implement strategy",
      "build from sad",
      "generate code from architecture",
      "implement from architecture",
      "build strategy from",
      "code from sad",
      "implement sad"
    ],
    "patterns": [
      "implement.*strategy",
      "build.*from.*architecture",
      "generate.*code.*from.*sad",
      "/implement-strategy"
    ],
    "description": "Generate NinjaTrader code from a Strategy Architecture Document (SAD)"
  },
  "extract-nt-skills": {
    "triggers": [
      "extract skills",
      "extract from script",
      "parse ninjatrader",
      "extract nt skills",
      "skill extraction"
    ],
    "patterns": [
      "extract.*skills.*from",
      "parse.*ninjatrader",
      "/extract-nt-skills"
    ],
    "description": "Extract reusable skills from existing NinjaTrader scripts"
  },
  "strategy-iterator": {
    "triggers": [
      "iterate strategy",
      "iterate",
      "run iteration",
      "analyze backtest",
      "optimize strategy",
      "improve performance",
      "next version",
      "/iterate"
    ],
    "patterns": [
      "iterate.*strategy",
      "analyze.*backtest",
      "optimize.*strategy",
      "improve.*performance",
      "/iterate",
      "/strategy-iterator"
    ],
    "description": "Run V1-to-V5 iteration loop: analyze backtest, find problems, apply skills, document changes"
  }
}
