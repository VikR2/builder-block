{
  "generate-from-youtube": {
    "triggers": [
      "youtube",
      "generate from youtube",
      "convert this video",
      "from this youtube",
      "youtube.com/watch",
      "youtu.be/",
      "learn from this video",
      "create from video",
      "extract from youtube",
      "youtube strategy",
      "youtube indicator",
      "trading video"
    ],
    "patterns": [
      "\\bhttps?://(?:www\\.)?youtube\\.com/watch\\?v=[\\w-]+",
      "\\bhttps?://youtu\\.be/[\\w-]+",
      "generate.*youtube",
      "youtube.*strategy",
      "youtube.*indicator",
      "convert.*video",
      "from.*youtube"
    ],
    "description": "Automatically invoke when user mentions YouTube URLs or video generation for trading tutorials"
  },
  "implement-strategy": {
    "triggers": [
      "implement strategy",
      "build from sad",
      "generate code from architecture",
      "implement from architecture",
      "build strategy from",
      "code from sad",
      "implement sad"
    ],
    "patterns": [
      "implement.*strategy",
      "build.*from.*architecture",
      "generate.*code.*from.*sad",
      "/implement-strategy"
    ],
    "description": "Generate NinjaTrader code from a Strategy Architecture Document (SAD)"
  }
}
