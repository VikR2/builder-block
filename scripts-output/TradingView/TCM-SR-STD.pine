// =============================================================================
// MATCHING WINDOW TRACKING - 4:40 PM - 11:40 PM ET
// =============================================================================
matchingSessionTime = "1640-2340"
var float currentMatchingHigh = 0.0
var float currentMatchingLow = 0.0
var int currentMatchingStart = 0

var array<float> matchingHighs = array.new_float(0)
var array<float> matchingLows = array.new_float(0)
var array<int> matchingStarts = array.new_int(0)
var array<int> matchingEnds = array.new_int(0)
var array<box> matchingBoxes = array.new_box(0)
var array<box> overlayBoxes = array.new_box(0)
var array<line> overlayLines = array.new_line(0)
var array<linefill> overlayFills = array.new_linefill(0)
var array<label> overlayLabels = array.new_label(0)

inMatchingSession = InSession(matchingSessionTime, inputTimezone)
matchingSessionStart = inMatchingSession and not inMatchingSession[1]
matchingSessionEnd = not inMatchingSession and inMatchingSession[1]

if matchingSessionStart
