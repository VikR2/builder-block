// =============================================================================
// SESSION HELPER
// =============================================================================
InSession(sessionTime, sessionTimeZone=syminfo.timezone) =>
    not na(time(timeframe.period, sessionTime, sessionTimeZone))

// =============================================================================
// CME FUTURES HOLIDAY DETECTION
// =============================================================================
// CME Futures holidays - markets fully closed
// Note: CME has fewer holidays than NYSE, and some are early closes not full closes
isCMEHoliday(ts) =>
    m = month(ts, inputTimezone)
    d = dayofmonth(ts, inputTimezone)
    dow = dayofweek(ts, inputTimezone)  // 1=Sun, 2=Mon, 7=Sat

    // New Year's Day (Jan 1) - CME closed
    isNewYears = m == 1 and d == 1
    // MLK Day (3rd Monday in January) - CME closed
    isMLK = m == 1 and dow == 2 and d >= 15 and d <= 21
    // Presidents' Day (3rd Monday in February) - CME closed
    isPresidents = m == 2 and dow == 2 and d >= 15 and d <= 21
    // Good Friday - CME closed (approximate date range late March/April)
    isGoodFriday = (m == 3 or m == 4) and dow == 6 and d >= 19 and d <= 25
    // Memorial Day (last Monday in May) - CME closed
    isMemorial = m == 5 and dow == 2 and d >= 25
    // Juneteenth (June 19) - CME closed (since 2022)
    isJuneteenth = m == 6 and d == 19
    // Independence Day (July 4) - CME closed
    isIndependence = m == 7 and d == 4
    // Labor Day (1st Monday in September) - CME closed
    isLabor = m == 9 and dow == 2 and d <= 7
    // Thanksgiving (4th Thursday in November) - CME closed
    isThanksgiving = m == 11 and dow == 5 and d >= 22 and d <= 28
    // Christmas (Dec 25) - CME closed
    isChristmas = m == 12 and d == 25

    isNewYears or isMLK or isPresidents or isGoodFriday or isMemorial or isJuneteenth or isIndependence or isLabor or isThanksgiving or isChristmas

// Helper to check if current bar is on a valid CME futures trading day
// Note: Futures trade Sun evening - Fri, but sessions we track are Mon-Fri daytime
isFuturesTradingDay() =>
    dow = dayofweek(time, inputTimezone)
    // Sessions we track (SR, Monday box, etc.) only occur Mon-Fri
    isWeekday = dow >= 2 and dow <= 6  // Mon=2 through Fri=6
    isWeekday and not isCMEHoliday(time)

// =============================================================================
// BIAS CALCULATION (from TCM-Bias.pine)
// =============================================================================
getBiasDiff() =>
    yesterday = request.security(syminfo.tickerid, 'D', close[1], lookahead=barmerge.lookahead_on)
    today = request.security(syminfo.tickerid, 'D', close, lookahead=barmerge.lookahead_on)
    delta = today - yesterday
    percentage = delta / yesterday
    percentage

biasDiff = getBiasDiff()

var bool buying = false
buying := biasDiff > biasThreshold ? true : biasDiff < -biasThreshold ? false : buying

// =============================================================================
// SR SESSION TRACKING (12:40 PM - 3:20 PM ET)
// =============================================================================
srSessionTime = "1240-1520"

var float currentSRHigh = 0.0
var float currentSRLow = 0.0
var int currentSRStartBar = 0

inSRSession = InSession(srSessionTime, inputTimezone)
srSessionStart = inSRSession and not inSRSession[1]
srSessionEnd = not inSRSession and inSRSession[1]

// Track current session high/low and start bar
if srSessionStart
    currentSRHigh := high
    currentSRLow := low
    currentSRStartBar := bar_index
else if inSRSession
    currentSRHigh := math.max(currentSRHigh, high)
    currentSRLow := math.min(currentSRLow, low)

// =============================================================================
// 5-MINUTE SR DATA FETCH (for accurate SR range on 1H+ timeframes)
// =============================================================================
// On 1H timeframe, bars that overlap with SR session (12:40-3:20 PM) include
// price from outside the session window. This fetches 5-min data for accuracy.

// Helper function to track SR high/low from 5-minute bars
getSR5mData() =>
    inSR5m = InSession(srSessionTime, inputTimezone)
    srStart5m = inSR5m and not inSR5m[1]
    var float sr5mHigh = na
    var float sr5mLow = na
    if srStart5m
        sr5mHigh := high
        sr5mLow := low
    else if inSR5m
        sr5mHigh := math.max(sr5mHigh, high)
        sr5mLow := math.min(sr5mLow, low)
    [sr5mHigh, sr5mLow]

// Fetch from 5-minute timeframe (lookahead for historical accuracy)
[srHigh5m, srLow5m] = request.security(syminfo.tickerid, "5", getSR5mData(), lookahead=barmerge.lookahead_on)

// Use 5m-based SR when on hourly or higher timeframe (3600 seconds = 1 hour)
useHigherTFCorrection = timeframe.in_seconds() >= 3600

// =============================================================================
// SESSION BOX TRACKING (Monday, Tuesday, Wednesday) - Multi-day arrays
// =============================================================================
// Monday (Liquidity Hunt) - 9:20-11:40 AM ET
mondaySessionTime = "0920-1140"
var float currentMondayHigh = 0.0
var float currentMondayLow = 0.0
var int currentMondayStart = 0

var array<float> mondayHighs = array.new_float(0)
var array<float> mondayLows = array.new_float(0)
var array<int> mondayStarts = array.new_int(0)
var array<int> mondayEnds = array.new_int(0)
var array<box> mondayBoxes = array.new_box(0)

inMondaySession = InSession(mondaySessionTime, inputTimezone)
mondaySessionStart = inMondaySession and not inMondaySession[1]
mondaySessionEnd = not inMondaySession and inMondaySession[1]

if mondaySessionStart
    currentMondayHigh := high
    currentMondayLow := low
    currentMondayStart := bar_index
else if inMondaySession
    currentMondayHigh := math.max(currentMondayHigh, high)
    currentMondayLow := math.min(currentMondayLow, low)

if mondaySessionEnd and currentMondayHigh > 0
    array.unshift(mondayHighs, currentMondayHigh)
    array.unshift(mondayLows, currentMondayLow)
    array.unshift(mondayStarts, currentMondayStart)
    array.unshift(mondayEnds, bar_index)
    while array.size(mondayHighs) > maxDays
        array.pop(mondayHighs)
        array.pop(mondayLows)
        array.pop(mondayStarts)
        array.pop(mondayEnds)

