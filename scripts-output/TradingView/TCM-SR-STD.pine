// 7:00 AM Open
open700Time = "0700-1400"
var float current700Price = 0.0
var int current700Start = 0

var array<float> open700Prices = array.new_float(0)
var array<int> open700Starts = array.new_int(0)
var array<int> open700Ends = array.new_int(0)
var array<line> open700Lines = array.new_line(0)
var array<label> open700Labels = array.new_label(0)

inOpen700 = InSession(open700Time, inputTimezone) and timeframe.isintraday
open700Start = inOpen700 and not inOpen700[1]
open700End = not inOpen700 and inOpen700[1]

if open700Start
    current700Price := open
