// =============================================================================
// ARRAYS TO STORE MULTIPLE DAYS OF SR DATA
// =============================================================================
var array<float> srHighs = array.new_float(0)
var array<float> srLows = array.new_float(0)
var array<int> srStartBars = array.new_int(0)
var array<int> srEndBars = array.new_int(0)

// Arrays for lines
var array<line> longT1Lines = array.new_line(0)
var array<line> longT2Lines = array.new_line(0)
var array<line> shortT1Lines = array.new_line(0)
var array<line> shortT2Lines = array.new_line(0)
var array<line> longHalfLines = array.new_line(0)
var array<line> shortHalfLines = array.new_line(0)
var array<line> long2Lines = array.new_line(0)
var array<line> short2Lines = array.new_line(0)
var array<line> srHighLines = array.new_line(0)
var array<line> srLowLines = array.new_line(0)
var array<line> srEQLines = array.new_line(0)
var array<box> srBoxes = array.new_box(0)

// Arrays for labels
var array<label> longT1Labels = array.new_label(0)
var array<label> longT2Labels = array.new_label(0)
var array<label> shortT1Labels = array.new_label(0)
var array<label> shortT2Labels = array.new_label(0)
var array<label> longHalfLabels = array.new_label(0)
var array<label> shortHalfLabels = array.new_label(0)
var array<label> long2Labels = array.new_label(0)
var array<label> short2Labels = array.new_label(0)
var array<label> srHighLabels = array.new_label(0)
var array<label> srLowLabels = array.new_label(0)
var array<label> srEQLabels = array.new_label(0)

// =============================================================================
// SAVE SR DATA WHEN SESSION ENDS
// =============================================================================
if srSessionEnd and currentSRHigh > 0
    // Use 5m data for 1H+ timeframes to get accurate SR range
    // On lower timeframes, use native bar data
    float finalSRHigh = useHigherTFCorrection and not na(srHigh5m) ? srHigh5m : currentSRHigh
    float finalSRLow = useHigherTFCorrection and not na(srLow5m) ? srLow5m : currentSRLow

    // Add new SR data at the beginning of arrays
    array.unshift(srHighs, finalSRHigh)
    array.unshift(srLows, finalSRLow)
    array.unshift(srStartBars, currentSRStartBar)
    array.unshift(srEndBars, bar_index)

    // Trim arrays to max days
    while array.size(srHighs) > maxDays
        array.pop(srHighs)
        array.pop(srLows)
        array.pop(srStartBars)
        array.pop(srEndBars)

// =============================================================================
// TARGET HIT TRACKING (for most recent SR session only)
// =============================================================================
var bool longT1Hit = false
var bool longT2Hit = false
var bool shortT1Hit = false
var bool shortT2Hit = false
var bool longHalfHit = false
var bool shortHalfHit = false
var bool long2Hit = false
var bool short2Hit = false

// Reset hit flags when new SR session ends (new SR data is captured)
// This ensures checkmarks only show for hits on the CURRENT SR session
if srSessionEnd and currentSRHigh > 0
    longT1Hit := false
    longT2Hit := false
    shortT1Hit := false
    shortT2Hit := false
    longHalfHit := false
    shortHalfHit := false
    long2Hit := false
    short2Hit := false

// Track hits for most recent SR
if array.size(srHighs) > 0
    recentHigh = array.get(srHighs, 0)
    recentLow = array.get(srLows, 0)
    recentRange = recentHigh - recentLow
    recentLongT1 = recentHigh + (recentRange * target1STDMultiplier)
    recentLongT2 = recentHigh + (recentRange * target2STDMultiplier)
    recentShortT1 = recentLow - (recentRange * target1STDMultiplier)
    recentShortT2 = recentLow - (recentRange * target2STDMultiplier)
    recentLongHalf = recentHigh + (recentRange * 0.5)
    recentShortHalf = recentLow - (recentRange * 0.5)
    recentLong2 = recentHigh + (recentRange * 2.0)
    recentShort2 = recentLow - (recentRange * 2.0)

    if not longT1Hit and high >= recentLongT1
        longT1Hit := true
    if not longT2Hit and high >= recentLongT2
        longT2Hit := true
    if not shortT1Hit and low <= recentShortT1
        shortT1Hit := true
    if not shortT2Hit and low <= recentShortT2
        shortT2Hit := true
    if not longHalfHit and high >= recentLongHalf
        longHalfHit := true
    if not shortHalfHit and low <= recentShortHalf
        shortHalfHit := true
    if not long2Hit and high >= recentLong2
        long2Hit := true
    if not short2Hit and low <= recentShort2
        short2Hit := true

// =============================================================================
// DRAW LINES AND LABELS
// =============================================================================
// Delete old lines and labels
if barstate.islast and showLines
    // Clear old lines
    for ln in longT1Lines
        line.delete(ln)
    for ln in longT2Lines
        line.delete(ln)
    for ln in shortT1Lines
        line.delete(ln)
    for ln in shortT2Lines
        line.delete(ln)
    for ln in longHalfLines
        line.delete(ln)
    for ln in shortHalfLines
        line.delete(ln)
    for ln in long2Lines
        line.delete(ln)
    for ln in short2Lines
        line.delete(ln)
    for ln in srHighLines
        line.delete(ln)
    for ln in srLowLines
        line.delete(ln)
    for ln in srEQLines
        line.delete(ln)
    for bx in srBoxes
        box.delete(bx)

    // Clear old labels
    for lb in longT1Labels
        label.delete(lb)
    for lb in longT2Labels
        label.delete(lb)
    for lb in shortT1Labels
        label.delete(lb)
    for lb in shortT2Labels
        label.delete(lb)
    for lb in longHalfLabels
        label.delete(lb)
    for lb in shortHalfLabels
        label.delete(lb)
    for lb in long2Labels
        label.delete(lb)
    for lb in short2Labels
        label.delete(lb)
    for lb in srHighLabels
        label.delete(lb)
    for lb in srLowLabels
        label.delete(lb)
    for lb in srEQLabels
        label.delete(lb)

    // Reset arrays
    array.clear(longT1Lines)
    array.clear(longT2Lines)
    array.clear(shortT1Lines)
    array.clear(shortT2Lines)
    array.clear(longHalfLines)
    array.clear(shortHalfLines)
    array.clear(long2Lines)
    array.clear(short2Lines)
    array.clear(srHighLines)
    array.clear(srLowLines)
    array.clear(srEQLines)
    array.clear(srBoxes)
    array.clear(longT1Labels)
    array.clear(longT2Labels)
    array.clear(shortT1Labels)
    array.clear(shortT2Labels)
    array.clear(longHalfLabels)
    array.clear(shortHalfLabels)
    array.clear(long2Labels)
    array.clear(short2Labels)
    array.clear(srHighLabels)
    array.clear(srLowLabels)
    array.clear(srEQLabels)

    // Draw lines for each day
    for i = 0 to math.min(array.size(srHighs) - 1, maxDays - 1)
        srH = array.get(srHighs, i)
        srL = array.get(srLows, i)
        srR = srH - srL
        startBar = array.get(srStartBars, i)

        // Calculate target prices
        longT1Price = srH + (srR * target1STDMultiplier)
        longT2Price = srH + (srR * target2STDMultiplier)
        shortT1Price = srL - (srR * target1STDMultiplier)
        shortT2Price = srL - (srR * target2STDMultiplier)
        longHalfPrice = srH + (srR * 0.5)
        shortHalfPrice = srL - (srR * 0.5)
        long2Price = srH + (srR * 2.0)
        short2Price = srL - (srR * 2.0)

        // Opacity decreases for older days (most recent = 0, older = more transparent)
        dayOpacity = i * 25  // 0, 25, 50, 75...

        // Determine colors based on bias (only for most recent day)
        isCurrentDay = (i == 0)

        // Long colors
        longBaseColor = buying ? bullishColor : color.new(bullishColor, 50)
        longT1Col = isCurrentDay and longT1Hit ? hitColor : color.new(longBaseColor, dayOpacity)
        longT2Col = isCurrentDay and longT2Hit ? hitColor : color.new(longBaseColor, dayOpacity)
        longHalfCol = isCurrentDay and longHalfHit ? hitColor : color.new(longBaseColor, dayOpacity)
        long2Col = isCurrentDay and long2Hit ? hitColor : color.new(longBaseColor, dayOpacity)

        // Short colors
        shortBaseColor = buying ? color.new(bearishColor, 50) : bearishColor
        shortT1Col = isCurrentDay and shortT1Hit ? hitColor : color.new(shortBaseColor, dayOpacity)
        shortT2Col = isCurrentDay and shortT2Hit ? hitColor : color.new(shortBaseColor, dayOpacity)
        shortHalfCol = isCurrentDay and shortHalfHit ? hitColor : color.new(shortBaseColor, dayOpacity)
        short2Col = isCurrentDay and short2Hit ? hitColor : color.new(shortBaseColor, dayOpacity)

        // Line style (solid for current day, dashed for older)
        lineStyle = isCurrentDay ? line.style_solid : line.style_dashed
        lineWidth = isCurrentDay ? 2 : 1

        // Day label suffix
        dayLabel = isCurrentDay ? "" : " (D-" + str.tostring(i) + ")"

        // Calculate SR EQ (equilibrium/midpoint)
        srEQ = (srH + srL) / 2

        // SR Range lines - more visible with solid style and better width
        if showSRRange
            srHighLn = line.new(startBar, srH, bar_index + lineExtension, srH,
                               color=color.new(srRangeColor, dayOpacity), width=2, style=line.style_solid)
            srLowLn = line.new(startBar, srL, bar_index + lineExtension, srL,
                              color=color.new(srRangeColor, dayOpacity), width=2, style=line.style_solid)
            array.push(srHighLines, srHighLn)
            array.push(srLowLines, srLowLn)

            if showLabels
                srHLbl = label.new(bar_index + labelOffset, srH, "SR High " + str.tostring(srH, "#.##") + dayLabel,
                                  style=label.style_none, textcolor=color.new(srRangeColor, dayOpacity), size=size.normal)
                srLLbl = label.new(bar_index + labelOffset, srL, "SR Low " + str.tostring(srL, "#.##") + dayLabel,
                                  style=label.style_none, textcolor=color.new(srRangeColor, dayOpacity), size=size.normal)
                array.push(srHighLabels, srHLbl)
                array.push(srLowLabels, srLLbl)

        // SR EQ (Equilibrium) line
        if showSREQ
            srEQLn = line.new(startBar, srEQ, bar_index + lineExtension, srEQ,
                             color=color.new(srEQColor, dayOpacity), width=2, style=line.style_dashed)
            array.push(srEQLines, srEQLn)

            if showLabels
                srEQLbl = label.new(bar_index + labelOffset, srEQ, "SR EQ " + str.tostring(srEQ, "#.##") + dayLabel,
                                   style=label.style_none, textcolor=color.new(srEQColor, dayOpacity), size=size.normal)
                array.push(srEQLabels, srEQLbl)

        // SR Box (shaded rectangle for SR session range)
        if showSRBox
            endBar = array.get(srEndBars, i)
            // Box transparency: 85 for current day, more transparent for older days
            boxOpacity = 85 + (i * 5)
            srBx = box.new(startBar, srH, endBar, srL,
                          border_color=color.new(srBoxColor, dayOpacity + 30),
                          bgcolor=color.new(srBoxColor, boxOpacity),
                          border_width=1)
            array.push(srBoxes, srBx)

        // STD Lines - only for most recent SR session
        if isCurrentDay
            // Long T1 Line
            longT1Ln = line.new(startBar, longT1Price, bar_index + lineExtension, longT1Price,
                               color=longT1Col, width=lineWidth, style=lineStyle)
            array.push(longT1Lines, longT1Ln)

            // Long T2 Line
            longT2Ln = line.new(startBar, longT2Price, bar_index + lineExtension, longT2Price,
                               color=longT2Col, width=lineWidth, style=lineStyle)
            array.push(longT2Lines, longT2Ln)

            // Short T1 Line
            shortT1Ln = line.new(startBar, shortT1Price, bar_index + lineExtension, shortT1Price,
                                color=shortT1Col, width=lineWidth, style=lineStyle)
            array.push(shortT1Lines, shortT1Ln)

            // Short T2 Line
            shortT2Ln = line.new(startBar, shortT2Price, bar_index + lineExtension, shortT2Price,
                                color=shortT2Col, width=lineWidth, style=lineStyle)
            array.push(shortT2Lines, shortT2Ln)

            // 0.5 STD Lines (optional)
            if showHalfSTD
                longHalfLn = line.new(startBar, longHalfPrice, bar_index + lineExtension, longHalfPrice,
                                     color=longHalfCol, width=lineWidth, style=line.style_dotted)
                shortHalfLn = line.new(startBar, shortHalfPrice, bar_index + lineExtension, shortHalfPrice,
                                      color=shortHalfCol, width=lineWidth, style=line.style_dotted)
                array.push(longHalfLines, longHalfLn)
                array.push(shortHalfLines, shortHalfLn)

            // 2.0 STD Lines (optional)
            if show2STD
                long2Ln = line.new(startBar, long2Price, bar_index + lineExtension, long2Price,
                                  color=long2Col, width=lineWidth, style=lineStyle)
                short2Ln = line.new(startBar, short2Price, bar_index + lineExtension, short2Price,
                                   color=short2Col, width=lineWidth, style=lineStyle)
                array.push(long2Lines, long2Ln)
                array.push(short2Lines, short2Ln)

            // STD Labels - only for most recent SR session
            if showLabels
                // Status indicators for current day
                t1LongStatus = longT1Hit ? "✓ " : ""
                t2LongStatus = longT2Hit ? "✓ " : ""
                t1ShortStatus = shortT1Hit ? "✓ " : ""
                t2ShortStatus = shortT2Hit ? "✓ " : ""

                // Bias-aware label names
                // When BULLISH: Long targets are primary "Target", Short targets are reversal "MAX Low"
                // When BEARISH: Short targets are primary "Target", Long targets are reversal "MAX High"
                longT1Name = buying ? "Target (" + str.tostring(target1STDMultiplier, "#.#") + " STD)" : "MAX High (" + str.tostring(target1STDMultiplier, "#.#") + " STD)"
                longT2Name = buying ? "Target (" + str.tostring(target2STDMultiplier, "#.#") + " STD)" : "MAX High (" + str.tostring(target2STDMultiplier, "#.#") + " STD)"
                shortT1Name = buying ? "MAX Low (" + str.tostring(target1STDMultiplier, "#.#") + " STD)" : "Target (" + str.tostring(target1STDMultiplier, "#.#") + " STD)"
                shortT2Name = buying ? "MAX Low (" + str.tostring(target2STDMultiplier, "#.#") + " STD)" : "Target (" + str.tostring(target2STDMultiplier, "#.#") + " STD)"

                longT1Lbl = label.new(bar_index + labelOffset, longT1Price,
                                     t1LongStatus + longT1Name + " " + str.tostring(longT1Price, "#.##"),
                                     style=label.style_none, textcolor=longT1Col, size=size.normal)
                longT2Lbl = label.new(bar_index + labelOffset, longT2Price,
                                     t2LongStatus + longT2Name + " " + str.tostring(longT2Price, "#.##"),
                                     style=label.style_none, textcolor=longT2Col, size=size.normal)
                shortT1Lbl = label.new(bar_index + labelOffset, shortT1Price,
                                      t1ShortStatus + shortT1Name + " " + str.tostring(shortT1Price, "#.##"),
                                      style=label.style_none, textcolor=shortT1Col, size=size.normal)
                shortT2Lbl = label.new(bar_index + labelOffset, shortT2Price,
                                      t2ShortStatus + shortT2Name + " " + str.tostring(shortT2Price, "#.##"),
                                      style=label.style_none, textcolor=shortT2Col, size=size.normal)

                array.push(longT1Labels, longT1Lbl)
                array.push(longT2Labels, longT2Lbl)
                array.push(shortT1Labels, shortT1Lbl)
                array.push(shortT2Labels, shortT2Lbl)

                // 0.5 STD Labels
                if showHalfSTD
                    halfLongStatus = longHalfHit ? "✓ " : ""
                    halfShortStatus = shortHalfHit ? "✓ " : ""
                    longHalfName = buying ? "Target (0.5 STD)" : "MAX High (0.5 STD)"
                    shortHalfName = buying ? "MAX Low (0.5 STD)" : "Target (0.5 STD)"
                    longHalfLbl = label.new(bar_index + labelOffset, longHalfPrice,
                                           halfLongStatus + longHalfName + " " + str.tostring(longHalfPrice, "#.##"),
                                           style=label.style_none, textcolor=longHalfCol, size=size.small)
                    shortHalfLbl = label.new(bar_index + labelOffset, shortHalfPrice,
                                            halfShortStatus + shortHalfName + " " + str.tostring(shortHalfPrice, "#.##"),
                                            style=label.style_none, textcolor=shortHalfCol, size=size.small)
                    array.push(longHalfLabels, longHalfLbl)
                    array.push(shortHalfLabels, shortHalfLbl)

                // 2.0 STD Labels
                if show2STD
                    twoLongStatus = long2Hit ? "✓ " : ""
                    twoShortStatus = short2Hit ? "✓ " : ""
                    long2Name = buying ? "Target (2.0 STD)" : "MAX High (2.0 STD)"
                    short2Name = buying ? "MAX Low (2.0 STD)" : "Target (2.0 STD)"
                    long2Lbl = label.new(bar_index + labelOffset, long2Price,
                                        twoLongStatus + long2Name + " " + str.tostring(long2Price, "#.##"),
                                        style=label.style_none, textcolor=long2Col, size=size.normal)
                    short2Lbl = label.new(bar_index + labelOffset, short2Price,
                                         twoShortStatus + short2Name + " " + str.tostring(short2Price, "#.##"),
                                         style=label.style_none, textcolor=short2Col, size=size.normal)
                    array.push(long2Labels, long2Lbl)
                    array.push(short2Labels, short2Lbl)

    // =========================================================================
    // DRAW SESSION BOXES (Monday, Tuesday, Wednesday)
    // =========================================================================
    // Clear old session boxes
    for bx in mondayBoxes
        box.delete(bx)
    for bx in tuesdayBoxes
        box.delete(bx)
    for bx in wednesdayBoxes
        box.delete(bx)
    array.clear(mondayBoxes)
    array.clear(tuesdayBoxes)
    array.clear(wednesdayBoxes)

    // Draw Monday boxes (use input colors directly - they already have opacity set)
    if showMondayBox
        for i = 0 to math.min(array.size(mondayHighs) - 1, maxDays - 1)
            mH = array.get(mondayHighs, i)
            mL = array.get(mondayLows, i)
            mStart = array.get(mondayStarts, i)
            mEnd = array.get(mondayEnds, i)
            // Add extra transparency for older days (i * 3 to keep subtle)
            extraOp = i * 3
            mBox = box.new(mStart, mH, mEnd, mL, border_color=color.new(mondayBoxBorderColor, extraOp), bgcolor=color.new(mondayBoxBgColor, math.min(92 + extraOp, 98)), border_width=1)
            array.push(mondayBoxes, mBox)

    // Draw Tuesday boxes
    if showTuesdayBox
        for i = 0 to math.min(array.size(tuesdayHighs) - 1, maxDays - 1)
            tH = array.get(tuesdayHighs, i)
            tL = array.get(tuesdayLows, i)
            tStart = array.get(tuesdayStarts, i)
            tEnd = array.get(tuesdayEnds, i)
            extraOp = i * 3
            tBox = box.new(tStart, tH, tEnd, tL, border_color=color.new(tuesdayBoxBorderColor, extraOp), bgcolor=color.new(tuesdayBoxBgColor, math.min(92 + extraOp, 98)), border_width=1)
            array.push(tuesdayBoxes, tBox)

    // Draw Wednesday boxes
    if showWednesdayBox
        for i = 0 to math.min(array.size(wednesdayHighs) - 1, maxDays - 1)
            wH = array.get(wednesdayHighs, i)
            wL = array.get(wednesdayLows, i)
            wStart = array.get(wednesdayStarts, i)
            wEnd = array.get(wednesdayEnds, i)
            extraOp = i * 3
            wBox = box.new(wStart, wH, wEnd, wL, border_color=color.new(wednesdayBoxBorderColor, extraOp), bgcolor=color.new(wednesdayBoxBgColor, math.min(92 + extraOp, 98)), border_width=1)
            array.push(wednesdayBoxes, wBox)

    // =========================================================================
    // DRAW MATCHING BOXES AND OVERLAY (THE BOOK)
    // =========================================================================
    // Clear old matching boxes and overlay
    for bx in matchingBoxes
        box.delete(bx)
    for bx in overlayBoxes
        box.delete(bx)
    for ln in overlayLines
        line.delete(ln)
    for lf in overlayFills
        linefill.delete(lf)
    for lb in overlayLabels
        label.delete(lb)
    array.clear(matchingBoxes)
    array.clear(overlayBoxes)
    array.clear(overlayLines)
    array.clear(overlayFills)
    array.clear(overlayLabels)

    // Draw Overlay Box (THE BOOK = SR ∩ Matching Window)
    // TCM Theory: SR (12:40-3:20 PM) contains orders submitted
    // These get matched in the Matching session (4:40 PM - 11:40 PM) same day
    // The Book = price overlap between SR and Matching window
    //
    // Visual: The box spans the MATCHING SESSION timeframe (4:40 - 11:40 PM)
    //         showing only the price levels where SR and Matching overlap
    //
    // Pairing: SR[i] pairs with the Matching session that starts AFTER SR ends

    if showOverlayBox and array.size(srHighs) > 0 and array.size(matchingHighs) > 0
        // For each SR, find the Matching session that FOLLOWS it
        for srIdx = 0 to math.min(array.size(srHighs) - 1, maxDays - 1)
            srH = array.get(srHighs, srIdx)
            srL = array.get(srLows, srIdx)
            srEndBar = array.get(srEndBars, srIdx)

            // Find the matching session that started AFTER this SR ended
            // Search for the closest matching session using bar_index timestamps
            matchIdx = -1
            smallestGap = 999999999
            for mIdx = 0 to array.size(matchingHighs) - 1
                mStartBar = array.get(matchingStarts, mIdx)
                if mStartBar > srEndBar
                    gap = mStartBar - srEndBar
                    if gap < smallestGap
                        smallestGap := gap
                        matchIdx := mIdx

            // If we found a matching session that follows this SR
            if matchIdx >= 0
                matchH = array.get(matchingHighs, matchIdx)
                matchL = array.get(matchingLows, matchIdx)
                matchStartBar = array.get(matchingStarts, matchIdx)
                matchEndBar = array.get(matchingEnds, matchIdx)

                // Calculate overlap (The Book) - price intersection only
                bookHigh = math.min(srH, matchH)
                bookLow = math.max(srL, matchL)

                // Only draw if there's valid overlap (prices intersect)
                hasOverlap = bookHigh > bookLow

                if hasOverlap
                    // Book midpoint for label placement
                    bookMid = (bookHigh + bookLow) / 2.0

                    // Opacity for older pairs
                    extraOp = srIdx * 15

                    // Calculate extension - either to chart edge or fixed bars
                    lineRightX = bookExtendRight ? bar_index + 100 : matchEndBar + bookExtensionBars

                    // Draw The Book as a clean shaded rectangle box
                    bookBox = box.new(
                        left = matchEndBar,
                        top = bookHigh,
                        right = lineRightX,
                        bottom = bookLow,
                        bgcolor = color.new(overlayBgColor, 60 + extraOp),
                        border_color = color.new(overlayBgColor, 30 + extraOp),
                        border_width = 1
                    )
                    array.push(overlayBoxes, bookBox)

                    // Label centered at top of box
                    bookCenterX = int((matchEndBar + lineRightX) / 2)
                    bookLabel = label.new(
                        x = bookCenterX,
                        y = bookHigh,
                        text = "Book",
                        style = label.style_none,
                        textcolor = color.new(overlayBgColor, extraOp),
                        size = size.small,
                        textalign = text.align_center
                    )
                    array.push(overlayLabels, bookLabel)

    // =========================================================================
    // DRAW OPENING PRICE LINES
    // =========================================================================
    // Clear old opening price lines and labels
    for ln in dailyCycleLines
        line.delete(ln)
    for lb in dailyCycleLabels
        label.delete(lb)
    for ln in amOpenLines
        line.delete(ln)
    for lb in amOpenLabels
        label.delete(lb)
    for ln in open440Lines
        line.delete(ln)
    for lb in open440Labels
        label.delete(lb)
    for ln in open700Lines
        line.delete(ln)
    for lb in open700Labels
        label.delete(lb)
    array.clear(dailyCycleLines)
    array.clear(dailyCycleLabels)
    array.clear(amOpenLines)
    array.clear(amOpenLabels)
    array.clear(open440Lines)
    array.clear(open440Labels)
    array.clear(open700Lines)
    array.clear(open700Labels)

    // Draw Daily Cycle Open lines
    if showDailyCycleOpen
        for i = 0 to math.min(array.size(dailyCyclePrices) - 1, maxDays - 1)
            dcPrice = array.get(dailyCyclePrices, i)
            dcStart = array.get(dailyCycleStarts, i)
            dcEnd = array.get(dailyCycleEnds, i)
            dayOp = i * 20
            dcLn = line.new(dcStart, dcPrice, dcEnd, dcPrice, color=color.new(dailyCycleOpenColor, dayOp), width=1)
            dcLbl = label.new(dcEnd, dcPrice, "Daily CYCLE OPEN", style=label.style_none, textcolor=color.new(dailyCycleOpenColor, dayOp), size=size.small, textalign=text.align_left)
            array.push(dailyCycleLines, dcLn)
            array.push(dailyCycleLabels, dcLbl)

    // Draw AM Open lines
    if showAMOpen
        for i = 0 to math.min(array.size(amOpenPrices) - 1, maxDays - 1)
            amPrice = array.get(amOpenPrices, i)
            amStart = array.get(amOpenStarts, i)
            amEnd = array.get(amOpenEnds, i)
            dayOp = i * 20
            amLn = line.new(amStart, amPrice, amEnd, amPrice, color=color.new(amOpenColor, dayOp), width=1)
            amLbl = label.new(amEnd, amPrice, "AM Open", style=label.style_none, textcolor=color.new(amOpenColor, dayOp), size=size.small, textalign=text.align_left)
            array.push(amOpenLines, amLn)
            array.push(amOpenLabels, amLbl)

    // Draw 4:40 AM Open lines
    if show440Open
        for i = 0 to math.min(array.size(open440Prices) - 1, maxDays - 1)
            p440 = array.get(open440Prices, i)
            s440 = array.get(open440Starts, i)
            e440 = array.get(open440Ends, i)
            dayOp = i * 20
            ln440 = line.new(s440, p440, e440, p440, color=color.new(open440Color, dayOp), width=1)
            lbl440 = label.new(e440, p440, "4:40 am", style=label.style_none, textcolor=color.new(open440Color, dayOp), size=size.small, textalign=text.align_left)
            array.push(open440Lines, ln440)
            array.push(open440Labels, lbl440)

    // Draw 7:00 AM Open lines
    if show700Open
        for i = 0 to math.min(array.size(open700Prices) - 1, maxDays - 1)
            p700 = array.get(open700Prices, i)
            s700 = array.get(open700Starts, i)
            e700 = array.get(open700Ends, i)
            dayOp = i * 20
            ln700 = line.new(s700, p700, e700, p700, color=color.new(open700Color, dayOp), width=1)
            lbl700 = label.new(e700, p700, "7:00 am", style=label.style_none, textcolor=color.new(open700Color, dayOp), size=size.small, textalign=text.align_left)
            array.push(open700Lines, ln700)
            array.push(open700Labels, lbl700)

// =============================================================================
// INFO BOX
// =============================================================================
var table infoBox = table.new(position.top_right, 3, 12, bgcolor=color.new(#2a2e39, 15), border_width=1, border_color=color.new(#363a45, 30))

if barstate.islast and showInfoBox and array.size(srHighs) > 0
    // Get most recent SR data
    srHigh = array.get(srHighs, 0)
    srLow = array.get(srLows, 0)
    srRange = srHigh - srLow
    srEQPrice = (srHigh + srLow) / 2
    longT1Price = srHigh + (srRange * target1STDMultiplier)
    longT2Price = srHigh + (srRange * target2STDMultiplier)
    shortT1Price = srLow - (srRange * target1STDMultiplier)
    shortT2Price = srLow - (srRange * target2STDMultiplier)

    // Clear table first
    table.clear(infoBox, 0, 0, 2, 11)

    // Header - Bias
    biasText = buying ? "▲ BULLISH" : "▼ BEARISH"
    biasCol = buying ? bullishColor : bearishColor
    table.cell(infoBox, 0, 0, "BIAS", text_color=color.gray, text_size=size.normal, text_halign=text.align_left)
    table.cell(infoBox, 1, 0, biasText, text_color=biasCol, text_size=size.large, text_halign=text.align_right)
    table.merge_cells(infoBox, 1, 0, 2, 0)

    // SR Range info with High, Low, EQ
    table.cell(infoBox, 0, 1, "── SR RANGE ──", text_color=color.gray, text_size=size.small, text_halign=text.align_center)
    table.merge_cells(infoBox, 0, 1, 2, 1)

    table.cell(infoBox, 0, 2, "High", text_color=srRangeColor, text_size=size.small, text_halign=text.align_left)
    table.cell(infoBox, 1, 2, str.tostring(srHigh, "#.##"), text_color=srRangeColor, text_size=size.normal, text_halign=text.align_right)
    table.merge_cells(infoBox, 1, 2, 2, 2)

    table.cell(infoBox, 0, 3, "EQ", text_color=srEQColor, text_size=size.small, text_halign=text.align_left)
    table.cell(infoBox, 1, 3, str.tostring(srEQPrice, "#.##"), text_color=srEQColor, text_size=size.normal, text_halign=text.align_right)
    table.merge_cells(infoBox, 1, 3, 2, 3)

    table.cell(infoBox, 0, 4, "Low", text_color=srRangeColor, text_size=size.small, text_halign=text.align_left)
    table.cell(infoBox, 1, 4, str.tostring(srLow, "#.##"), text_color=srRangeColor, text_size=size.normal, text_halign=text.align_right)
    table.merge_cells(infoBox, 1, 4, 2, 4)

    // Targets section with hit status
    if buying
        // Primary targets (Long)
        table.cell(infoBox, 0, 5, "── TARGETS (LONG) ──", text_color=color.gray, text_size=size.small, text_halign=text.align_center)
        table.merge_cells(infoBox, 0, 5, 2, 5)

        t1Status = longT1Hit ? "✓" : "○"
        t1Color = longT1Hit ? hitColor : bullishColor
        table.cell(infoBox, 0, 6, t1Status, text_color=t1Color, text_size=size.normal, text_halign=text.align_center)
        table.cell(infoBox, 1, 6, str.tostring(target1STDMultiplier, "#.#") + " STD", text_color=t1Color, text_size=size.normal, text_halign=text.align_left)
        table.cell(infoBox, 2, 6, str.tostring(longT1Price, "#.##"), text_color=t1Color, text_size=size.normal, text_halign=text.align_right)

        t2Status = longT2Hit ? "✓" : "○"
        t2Color = longT2Hit ? hitColor : bullishColor
        table.cell(infoBox, 0, 7, t2Status, text_color=t2Color, text_size=size.normal, text_halign=text.align_center)
        table.cell(infoBox, 1, 7, str.tostring(target2STDMultiplier, "#.#") + " STD", text_color=t2Color, text_size=size.normal, text_halign=text.align_left)
        table.cell(infoBox, 2, 7, str.tostring(longT2Price, "#.##"), text_color=t2Color, text_size=size.normal, text_halign=text.align_right)

        if longT2Hit
            table.cell(infoBox, 0, 8, "→ SCALP SHORT", text_color=bearishColor, text_size=size.small, text_halign=text.align_center)
            table.merge_cells(infoBox, 0, 8, 2, 8)

        table.cell(infoBox, 0, 9, "── MAX LOW (REVERSAL) ──", text_color=color.gray, text_size=size.small, text_halign=text.align_center)
        table.merge_cells(infoBox, 0, 9, 2, 9)

        revStatus = shortT2Hit ? "✓" : "○"
        revColor = shortT2Hit ? hitColor : color.new(bearishColor, 50)
        table.cell(infoBox, 0, 10, revStatus, text_color=revColor, text_size=size.normal, text_halign=text.align_center)
        table.cell(infoBox, 1, 10, str.tostring(target2STDMultiplier, "#.#") + " STD", text_color=revColor, text_size=size.normal, text_halign=text.align_left)
        table.cell(infoBox, 2, 10, str.tostring(shortT2Price, "#.##"), text_color=revColor, text_size=size.normal, text_halign=text.align_right)
    else
        // Primary targets (Short)
        table.cell(infoBox, 0, 5, "── TARGETS (SHORT) ──", text_color=color.gray, text_size=size.small, text_halign=text.align_center)
        table.merge_cells(infoBox, 0, 5, 2, 5)

        t1Status = shortT1Hit ? "✓" : "○"
        t1Color = shortT1Hit ? hitColor : bearishColor
        table.cell(infoBox, 0, 6, t1Status, text_color=t1Color, text_size=size.normal, text_halign=text.align_center)
        table.cell(infoBox, 1, 6, str.tostring(target1STDMultiplier, "#.#") + " STD", text_color=t1Color, text_size=size.normal, text_halign=text.align_left)
        table.cell(infoBox, 2, 6, str.tostring(shortT1Price, "#.##"), text_color=t1Color, text_size=size.normal, text_halign=text.align_right)

        t2Status = shortT2Hit ? "✓" : "○"
        t2Color = shortT2Hit ? hitColor : bearishColor
        table.cell(infoBox, 0, 7, t2Status, text_color=t2Color, text_size=size.normal, text_halign=text.align_center)
        table.cell(infoBox, 1, 7, str.tostring(target2STDMultiplier, "#.#") + " STD", text_color=t2Color, text_size=size.normal, text_halign=text.align_left)
        table.cell(infoBox, 2, 7, str.tostring(shortT2Price, "#.##"), text_color=t2Color, text_size=size.normal, text_halign=text.align_right)

        if shortT2Hit
            table.cell(infoBox, 0, 8, "→ SCALP LONG", text_color=bullishColor, text_size=size.small, text_halign=text.align_center)
            table.merge_cells(infoBox, 0, 8, 2, 8)

        table.cell(infoBox, 0, 9, "── MAX HIGH (REVERSAL) ──", text_color=color.gray, text_size=size.small, text_halign=text.align_center)
        table.merge_cells(infoBox, 0, 9, 2, 9)

        revStatus = longT2Hit ? "✓" : "○"
        revColor = longT2Hit ? hitColor : color.new(bullishColor, 50)
        table.cell(infoBox, 0, 10, revStatus, text_color=revColor, text_size=size.normal, text_halign=text.align_center)
        table.cell(infoBox, 1, 10, str.tostring(target2STDMultiplier, "#.#") + " STD", text_color=revColor, text_size=size.normal, text_halign=text.align_left)
        table.cell(infoBox, 2, 10, str.tostring(longT2Price, "#.##"), text_color=revColor, text_size=size.normal, text_halign=text.align_right)

    // Timeframe warning for 1H+ (SR range fetched from 5m data)
    if useHigherTFCorrection
        table.cell(infoBox, 0, 11, "ℹ SR from 5m data", text_color=color.new(color.orange, 30), text_size=size.tiny, text_halign=text.align_center)
        table.merge_cells(infoBox, 0, 11, 2, 11)

// =============================================================================
// HOLIDAY INDICATOR (Debug)
// =============================================================================
// Shows a small marker on the first bar of a holiday to help identify skipped days
isHoliday = isCMEHoliday(time)
plotshape(showHolidayWarning and isHoliday and (not isHoliday[1] or barstate.isfirst),
    title="Holiday Marker",
    text="HOLIDAY",
    style=shape.labeldown,
    location=location.top,
    color=color.new(color.orange, 50),
    textcolor=color.white,
    size=size.tiny)
