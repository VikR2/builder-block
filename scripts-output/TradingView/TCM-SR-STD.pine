var int currentAMOpenStart = 0

var array<float> amOpenPrices = array.new_float(0)
var array<int> amOpenStarts = array.new_int(0)
var array<int> amOpenEnds = array.new_int(0)
var array<line> amOpenLines = array.new_line(0)
var array<label> amOpenLabels = array.new_label(0)

inAMOpen = InSession(amOpenTime, inputTimezone) and timeframe.isintraday
amOpenStart = inAMOpen and not inAMOpen[1]
amOpenEnd = not inAMOpen and inAMOpen[1]

if amOpenStart
