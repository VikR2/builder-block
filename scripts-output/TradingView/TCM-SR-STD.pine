//@version=6
indicator("TCM SR STD Lines", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// =============================================================================
// INPUTS
// =============================================================================
GRP_GENERAL = "General Settings"
maxDays = input.int(1, "Days to Display", minval=1, maxval=10, group=GRP_GENERAL,
    tooltip="How many previous days of SR, session boxes, overlays, and opening prices to display")

GRP_STD = "STD Settings"
target1STDMultiplier = input.float(1.0, "T1 STD Multiplier", step=0.1, group=GRP_STD)
target2STDMultiplier = input.float(1.5, "T2 STD Multiplier", step=0.1, group=GRP_STD)
biasThreshold = input.float(0, "Bias Threshold", step=0.001, group=GRP_STD, tooltip="Same as TCM-Bias threshold")
inputTimezone = input.string("America/New_York", "Timezone", group=GRP_STD)

// Additional STD levels (0.5 and 2.0)
showHalfSTD = input.bool(false, "Show 0.5 STD Lines", group=GRP_STD, tooltip="Show half standard deviation targets")
show2STD = input.bool(false, "Show 2.0 STD Lines", group=GRP_STD, tooltip="Show 2x standard deviation targets")

GRP_VIS = "Visual Settings"
showLines = input.bool(true, "Show STD Lines", group=GRP_VIS)
showLabels = input.bool(true, "Show Labels", group=GRP_VIS)
showInfoBox = input.bool(true, "Show Info Box", group=GRP_VIS)
showSRRange = input.bool(true, "Show SR Range Lines", group=GRP_VIS)
showSREQ = input.bool(true, "Show SR EQ Line", group=GRP_VIS, tooltip="Show SR Equilibrium (midpoint) line")
showSRBox = input.bool(true, "Show SR Box", group=GRP_VIS, tooltip="Show shaded box for SR session range")
lineExtension = input.int(50, "Line Extension (bars)", minval=5, maxval=200, group=GRP_VIS, tooltip="How far lines extend past current bar")
labelOffset = input.int(68, "Label Offset (bars)", minval=5, maxval=200, group=GRP_VIS, tooltip="Where labels are placed (should be >= line extension)")

GRP_COLORS = "Colors"
bullishColor = input.color(color.rgb(38, 166, 154), "Bullish Target Color", group=GRP_COLORS)
bearishColor = input.color(color.rgb(239, 83, 80), "Bearish Target Color", group=GRP_COLORS)
hitColor = input.color(color.rgb(255, 193, 7), "Hit Target Color", group=GRP_COLORS)
srRangeColor = input.color(color.rgb(100, 181, 246), "SR Range Color", group=GRP_COLORS)
srEQColor = input.color(color.rgb(255, 152, 0), "SR EQ Color", group=GRP_COLORS)
srBoxColor = input.color(color.rgb(156, 39, 176, 90), "SR Box Color", group=GRP_COLORS)

GRP_SESSIONS = "Session Boxes"

// Monday (Liquidity Hunt) Box - 9:20-11:40 AM ET
showMondayBox = input.bool(true, "Show Monday Box (9:20-11:40)", group=GRP_SESSIONS)
mondayBoxBgColor = input.color(color.new(#BD93F9, 96), "Monday Background", group=GRP_SESSIONS)
mondayBoxBorderColor = input.color(color.new(#BD93F9, 70), "Monday Border", group=GRP_SESSIONS)

// Tuesday (Offset) Box - 4:40-11:40 PM ET
showTuesdayBox = input.bool(true, "Show Tuesday Box (16:40-23:40)", group=GRP_SESSIONS)
tuesdayBoxBgColor = input.color(color.new(#2F4F4F, 96), "Tuesday Background", group=GRP_SESSIONS)
tuesdayBoxBorderColor = input.color(color.new(#2F4F4F, 70), "Tuesday Border", group=GRP_SESSIONS)

// Wednesday (Rebalance) Box - 2:00-4:40 AM ET
showWednesdayBox = input.bool(true, "Show Wednesday Box (2:00-4:40)", group=GRP_SESSIONS)
wednesdayBoxBgColor = input.color(color.new(#005B5B, 96), "Wednesday Background", group=GRP_SESSIONS)
wednesdayBoxBorderColor = input.color(color.new(#005B5B, 70), "Wednesday Border", group=GRP_SESSIONS)

// =============================================================================
// MATCHING OVERLAY (THE BOOK) INPUTS
// =============================================================================
GRP_OVERLAY = "Matching Overlay (The Book)"
showOverlayBox = input.bool(true, "Show Book (SR+Matching Overlap)", group=GRP_OVERLAY, tooltip="Shows the overlap between Submission Range and Matching Window - this is 'The Book' where liquidity exists")
