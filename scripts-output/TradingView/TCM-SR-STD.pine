//@version=6
indicator("TCM SR STD Lines", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// =============================================================================
// INPUTS
// =============================================================================
GRP_GENERAL = "General Settings"
maxDays = input.int(1, "Days to Display", minval=1, maxval=10, group=GRP_GENERAL,
    tooltip="How many previous days of SR, session boxes, overlays, and opening prices to display")

GRP_STD = "STD Settings"
target1STDMultiplier = input.float(1.0, "T1 STD Multiplier", step=0.1, group=GRP_STD)
target2STDMultiplier = input.float(1.5, "T2 STD Multiplier", step=0.1, group=GRP_STD)
biasThreshold = input.float(0, "Bias Threshold", step=0.001, group=GRP_STD, tooltip="Same as TCM-Bias threshold")
inputTimezone = input.string("America/New_York", "Timezone", group=GRP_STD)

// Additional STD levels (0.5 and 2.0)
showHalfSTD = input.bool(false, "Show 0.5 STD Lines", group=GRP_STD, tooltip="Show half standard deviation targets")
show2STD = input.bool(false, "Show 2.0 STD Lines", group=GRP_STD, tooltip="Show 2x standard deviation targets")

GRP_VIS = "Visual Settings"
showLines = input.bool(true, "Show STD Lines", group=GRP_VIS)
showLabels = input.bool(true, "Show Labels", group=GRP_VIS)
