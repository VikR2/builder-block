var array<float> open440Prices = array.new_float(0)
var array<int> open440Starts = array.new_int(0)
var array<int> open440Ends = array.new_int(0)
var array<line> open440Lines = array.new_line(0)
var array<label> open440Labels = array.new_label(0)

inOpen440 = InSession(open440Time, inputTimezone) and timeframe.isintraday
