    array.unshift(matchingStarts, currentMatchingStart)
    array.unshift(matchingEnds, bar_index)
    while array.size(matchingHighs) > maxDays
        array.pop(matchingHighs)
        array.pop(matchingLows)
        array.pop(matchingStarts)
        array.pop(matchingEnds)

// =============================================================================
// OPENING PRICE TRACKING - Multi-day arrays
// =============================================================================
// Daily Cycle Open (11:40 AM)
dailyCycleTime = "1140-3920"
var float currentDailyCyclePrice = 0.0
var int currentDailyCycleStart = 0
var int currentDailyCycleEnd = 0

var array<float> dailyCyclePrices = array.new_float(0)
var array<int> dailyCycleStarts = array.new_int(0)
var array<int> dailyCycleEnds = array.new_int(0)
var array<line> dailyCycleLines = array.new_line(0)
var array<label> dailyCycleLabels = array.new_label(0)

inDailyCycle = InSession(dailyCycleTime, inputTimezone) and timeframe.isintraday
dailyCycleStart = inDailyCycle and not inDailyCycle[1]
dailyCycleEnd = not inDailyCycle and inDailyCycle[1]

if dailyCycleStart
    currentDailyCyclePrice := open
    currentDailyCycleStart := bar_index

if dailyCycleEnd and currentDailyCyclePrice > 0
    array.unshift(dailyCyclePrices, currentDailyCyclePrice)
    array.unshift(dailyCycleStarts, currentDailyCycleStart)
    array.unshift(dailyCycleEnds, bar_index)
    while array.size(dailyCyclePrices) > maxDays
        array.pop(dailyCyclePrices)
        array.pop(dailyCycleStarts)
        array.pop(dailyCycleEnds)

// AM Open (2:00 AM)
amOpenTime = "0200-1440"
