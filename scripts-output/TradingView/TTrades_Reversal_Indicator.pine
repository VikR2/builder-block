// © TTrades Reversal Visualization

//@version=6
indicator("TTrades 5-Stage Reversal", overlay=true, max_boxes_count=100, max_labels_count=100, max_lines_count=50)

// ============================================================================
// INPUT SETTINGS
// ============================================================================

// --- Time Settings ---
GRP_TIME = "Time Settings"
rangeStartHour = input.int(7, "Range Start Hour", minval=0, maxval=23, group=GRP_TIME)
rangeStartMin = input.int(0, "Range Start Minute", minval=0, maxval=59, group=GRP_TIME)
rangeEndHour = input.int(7, "Range End Hour", minval=0, maxval=23, group=GRP_TIME)
rangeEndMin = input.int(40, "Range End Minute", minval=0, maxval=59, group=GRP_TIME)
sessionEndHour = input.int(16, "Session End Hour", minval=0, maxval=23, group=GRP_TIME)
timezoneInput = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "UTC"], group=GRP_TIME)

// --- Visual Settings ---
GRP_VISUAL = "Visual Elements"
showOpeningRange = input.bool(true, "Show Opening Range", group=GRP_VISUAL)
showEquilibrium = input.bool(true, "Show Equilibrium Line", group=GRP_VISUAL)
showFVGs = input.bool(true, "Show FVG Zones", group=GRP_VISUAL)
showSweepMarker = input.bool(true, "Show Sweep Markers", group=GRP_VISUAL)
showStageLabels = input.bool(true, "Show Stage Labels", group=GRP_VISUAL)
showDashboard = input.bool(true, "Show Dashboard Panel", group=GRP_VISUAL)
showEntryLevels = input.bool(true, "Show Entry/SL/TP", group=GRP_VISUAL)
showPDLevels = input.bool(true, "Show PDH/PDL", group=GRP_VISUAL)

// --- Cleanup Settings ---
GRP_CLEANUP = "Cleanup"
maxFVGBoxes = input.int(10, "Max FVG Boxes", minval=1, maxval=50, group=GRP_CLEANUP)
autoCleanMitigated = input.bool(true, "Auto-Clean Mitigated Zones", group=GRP_CLEANUP)

// --- Text Size Settings ---
GRP_SIZE = "Text Size"
labelSizeInput = input.string("Normal", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=GRP_SIZE)
dashSizeInput = input.string("Normal", "Dashboard Size", options=["Tiny", "Small", "Normal", "Large"], group=GRP_SIZE)

// Convert size strings to size constants
getLabelSize() =>
    switch labelSizeInput
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.normal

getDashSize() =>
    switch dashSizeInput
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.normal

labelSize = getLabelSize()
dashSize = getDashSize()

// ============================================================================
// COLOR SCHEME (Subtle/Muted Palette)
// ============================================================================

// Zone fills (very transparent)
var color RANGE_FILL = color.new(#6B7280, 90)
var color BULLISH_FVG_FILL = color.new(#10B981, 85)
var color BEARISH_FVG_FILL = color.new(#EF4444, 85)

// Border/Line colors
var color RANGE_BORDER = color.new(#9CA3AF, 60)
var color FVG_BORDER = color.new(#6B7280, 70)
var color EQUILIBRIUM_COLOR = color.new(#8B5CF6, 50)

// Sweep markers
var color SWEEP_BULLISH = color.new(#22C55E, 30)
var color SWEEP_BEARISH = color.new(#F97316, 30)

// Stage progression colors
var color STAGE_1_COLOR = color.new(#9CA3AF, 40)
var color STAGE_2_COLOR = color.new(#60A5FA, 40)
var color STAGE_3_COLOR = color.new(#A78BFA, 40)
var color STAGE_4_COLOR = color.new(#34D399, 40)
var color STAGE_5_COLOR = color.new(#10B981, 20)

// Entry/SL/TP
var color ENTRY_COLOR = color.new(#3B82F6, 30)
var color SL_COLOR = color.new(#EF4444, 30)
var color TP_COLOR = color.new(#22C55E, 30)

// PDH/PDL
var color PD_COLOR = color.new(#F59E0B, 50)

// Dashboard
var color DASH_BG = color.new(#1F2937, 10)
var color DASH_TEXT = color.new(#E5E7EB, 0)
var color DASH_BULLISH = color.new(#22C55E, 0)
var color DASH_BEARISH = color.new(#EF4444, 0)
var color DASH_NEUTRAL = color.new(#9CA3AF, 0)

// ============================================================================
// STATE VARIABLES
// ============================================================================

// Opening Range
var float rangeHigh = na
var float rangeLow = na
var bool rangeSet = false
var int rangeStartBar = na
var box rangeBox = na
var line eqLine = na

// Liquidity Sweep
var int sweepDirection = 0  // 0=none, 1=bullish (low swept), -1=bearish (high swept)
var float sweepPrice = na
var int sweepBar = na

// 5-Stage Tracking
var int reversalStage = 0
var bool stage1_purge = false
var bool stage2_inversion = false
var bool stage3_cisd = false
var bool stage4_newFVG = false
var bool stage5_breaker = false
var float refCandleOpen = na
var float refCandleHigh = na
var float refCandleLow = na

// FVG Arrays
var array<box> fvgBoxes = array.new_box()
var array<float> fvgTops = array.new_float()
var array<float> fvgBottoms = array.new_float()
var array<int> fvgDirs = array.new_int()

// Entry/SL/TP
var line entryLine = na
var line slLine = na
var line tpLine = na
var label entryLabel = na
var label slLabel = na
var label tpLabel = na

// PDH/PDL
var float PDH = na
var float PDL = na
var line pdhLine = na
var line pdlLine = na
var label pdhLabel = na
var label pdlLabel = na

// Dashboard
var table dashboardTable = na

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Get current bar time in session timezone
getBarHour() =>
    hour(time, timezoneInput)

getBarMinute() =>
    minute(time, timezoneInput)

// Check if in range building window
isRangeBuildSession() =>
    h = getBarHour()
    m = getBarMinute()
    currentMins = h * 60 + m
    startMins = rangeStartHour * 60 + rangeStartMin
    endMins = rangeEndHour * 60 + rangeEndMin
    currentMins >= startMins and currentMins < endMins

// Check if after range window
isAfterRangeWindow() =>
    h = getBarHour()
    m = getBarMinute()
    currentMins = h * 60 + m
    endMins = rangeEndHour * 60 + rangeEndMin
    currentMins >= endMins

// Check for new trading day
isNewDay() =>
    ta.change(time("D")) != 0

// Get stage color
getStageColor(stage) =>
    switch stage
        1 => STAGE_1_COLOR
        2 => STAGE_2_COLOR
        3 => STAGE_3_COLOR
        4 => STAGE_4_COLOR
        5 => STAGE_5_COLOR
        => STAGE_1_COLOR

// Get stage text
getStageText(stage) =>
    switch stage
        1 => "1:PURGE"
        2 => "2:INV"
        3 => "3:CISD"
        4 => "4:FVG"
        5 => "5:BREAK"
        => ""

// ============================================================================
// DAILY RESET
// ============================================================================

if isNewDay()
    // Reset range
    rangeHigh := na
    rangeLow := na
    rangeSet := false
    rangeStartBar := na

    // Reset sweep
    sweepDirection := 0
    sweepPrice := na
    sweepBar := na

    // Reset stages
    reversalStage := 0
    stage1_purge := false
    stage2_inversion := false
    stage3_cisd := false
    stage4_newFVG := false
    stage5_breaker := false
    refCandleOpen := na
    refCandleHigh := na
    refCandleLow := na

    // Delete old range drawings
    if not na(rangeBox)
        box.delete(rangeBox)
        rangeBox := na
    if not na(eqLine)
        line.delete(eqLine)
        eqLine := na

    // Delete entry lines
    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na
    if not na(slLine)
        line.delete(slLine)
        slLine := na
    if not na(tpLine)
        line.delete(tpLine)
        tpLine := na
    if not na(entryLabel)
        label.delete(entryLabel)
        entryLabel := na
    if not na(slLabel)
        label.delete(slLabel)
        slLabel := na
    if not na(tpLabel)
        label.delete(tpLabel)
        tpLabel := na

// ============================================================================
// PDH/PDL (Previous Day Levels)
// ============================================================================

[prevDayHigh, prevDayLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

if isNewDay()
    PDH := prevDayHigh
    PDL := prevDayLow

    // Update PDH/PDL lines
    if showPDLevels and not na(PDH)
        if not na(pdhLine)
            line.delete(pdhLine)
        if not na(pdlLine)
            line.delete(pdlLine)
        if not na(pdhLabel)
            label.delete(pdhLabel)
        if not na(pdlLabel)
            label.delete(pdlLabel)

        pdhLine := line.new(bar_index, PDH, bar_index + 1, PDH, color=PD_COLOR, style=line.style_dotted, width=1, extend=extend.right)
        pdlLine := line.new(bar_index, PDL, bar_index + 1, PDL, color=PD_COLOR, style=line.style_dotted, width=1, extend=extend.right)
        pdhLabel := label.new(bar_index, PDH, "PDH", style=label.style_none, textcolor=PD_COLOR, size=labelSize)
        pdlLabel := label.new(bar_index, PDL, "PDL", style=label.style_none, textcolor=PD_COLOR, size=labelSize)

// ============================================================================
// OPENING RANGE DETECTION
// ============================================================================

if isRangeBuildSession()
    if na(rangeHigh)
        rangeHigh := high
        rangeLow := low
        rangeStartBar := bar_index
    else
        rangeHigh := math.max(rangeHigh, high)
        rangeLow := math.min(rangeLow, low)

// Finalize range after window closes
if isAfterRangeWindow() and not rangeSet and not na(rangeHigh)
    rangeSet := true

    if showOpeningRange
        // Draw range box
        rangeBox := box.new(rangeStartBar, rangeHigh, bar_index + 50, rangeLow, bgcolor=RANGE_FILL, border_color=RANGE_BORDER, border_width=1, extend=extend.right)

        // Draw equilibrium line
        if showEquilibrium
            eqPrice = (rangeHigh + rangeLow) / 2.0
            eqLine := line.new(rangeStartBar, eqPrice, bar_index + 50, eqPrice, color=EQUILIBRIUM_COLOR, style=line.style_dotted, width=1, extend=extend.right)

        // Label
        label.new(rangeStartBar, rangeHigh + (rangeHigh - rangeLow) * 0.1, "OR", style=label.style_none, textcolor=RANGE_BORDER, size=labelSize)

// ============================================================================
// LIQUIDITY SWEEP DETECTION
// ============================================================================

if rangeSet and sweepDirection == 0
    // Low sweep - bullish setup
    if low < rangeLow
        sweepDirection := 1
        sweepPrice := low
        sweepBar := bar_index
        stage1_purge := true
        reversalStage := 1

        if showSweepMarker
            label.new(bar_index, low, "PURGE", style=label.style_label_up, color=color.new(SWEEP_BULLISH, 70), textcolor=SWEEP_BULLISH, size=labelSize)

    // High sweep - bearish setup
    else if high > rangeHigh
        sweepDirection := -1
        sweepPrice := high
        sweepBar := bar_index
        stage1_purge := true
        reversalStage := 1

        if showSweepMarker
            label.new(bar_index, high, "PURGE", style=label.style_label_down, color=color.new(SWEEP_BEARISH, 70), textcolor=SWEEP_BEARISH, size=labelSize)

// ============================================================================
// FVG DETECTION
// ============================================================================

// Standard 3-candle FVG
bullishFVG = low[2] > high[0]
bearishFVG = high[2] < low[0]

if showFVGs
    // Bullish FVG
    if bullishFVG
        fvgTop = low[2]
        fvgBottom = high[0]

        newBox = box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBottom, bgcolor=BULLISH_FVG_FILL, border_color=FVG_BORDER, border_width=1, extend=extend.right)

        array.push(fvgBoxes, newBox)
        array.push(fvgTops, fvgTop)
        array.push(fvgBottoms, fvgBottom)
        array.push(fvgDirs, 1)

        // Track for stage progression
        if stage1_purge and sweepDirection == 1 and not stage2_inversion
            stage2_inversion := true
            if reversalStage < 2
                reversalStage := 2
                if showStageLabels
                    label.new(bar_index, low, getStageText(2), style=label.style_label_up, color=color.new(getStageColor(2), 60), textcolor=getStageColor(2), size=labelSize)

        // Cleanup old boxes
        if array.size(fvgBoxes) > maxFVGBoxes
            oldBox = array.shift(fvgBoxes)
            box.delete(oldBox)
            array.shift(fvgTops)
            array.shift(fvgBottoms)
            array.shift(fvgDirs)

    // Bearish FVG
    if bearishFVG
        fvgTop = low[0]
        fvgBottom = high[2]

        newBox = box.new(bar_index - 2, fvgTop, bar_index + 20, fvgBottom, bgcolor=BEARISH_FVG_FILL, border_color=FVG_BORDER, border_width=1, extend=extend.right)

        array.push(fvgBoxes, newBox)
        array.push(fvgTops, fvgTop)
        array.push(fvgBottoms, fvgBottom)
        array.push(fvgDirs, -1)

        // Track for stage progression
        if stage1_purge and sweepDirection == -1 and not stage2_inversion
            stage2_inversion := true
            if reversalStage < 2
                reversalStage := 2
                if showStageLabels
                    label.new(bar_index, high, getStageText(2), style=label.style_label_down, color=color.new(getStageColor(2), 60), textcolor=getStageColor(2), size=labelSize)

        // Cleanup old boxes
        if array.size(fvgBoxes) > maxFVGBoxes
            oldBox = array.shift(fvgBoxes)
            box.delete(oldBox)
            array.shift(fvgTops)
            array.shift(fvgBottoms)
            array.shift(fvgDirs)

// FVG Mitigation Cleanup
if autoCleanMitigated and array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        if i < array.size(fvgBoxes)
            dir = array.get(fvgDirs, i)
            top = array.get(fvgTops, i)
            bottom = array.get(fvgBottoms, i)

            // Check if fully mitigated (price closed through)
            mitigated = (dir == 1 and close < bottom) or (dir == -1 and close > top)

            if mitigated
                box.delete(array.get(fvgBoxes, i))
                array.remove(fvgBoxes, i)
                array.remove(fvgTops, i)
                array.remove(fvgBottoms, i)
                array.remove(fvgDirs, i)

// ============================================================================
// CISD (Change in State of Delivery) - Stage 3
// ============================================================================

// Track reference candle (opposing candle after sweep)
if stage1_purge and na(refCandleOpen)
    if sweepDirection == 1 and close < open  // Bearish candle after low sweep
        refCandleOpen := open
        refCandleHigh := high
        refCandleLow := low
    if sweepDirection == -1 and close > open  // Bullish candle after high sweep
        refCandleOpen := open
        refCandleHigh := high
        refCandleLow := low

// Check for CISD
if stage2_inversion and not stage3_cisd and not na(refCandleOpen)
    if sweepDirection == 1 and close > refCandleOpen
        stage3_cisd := true
        if reversalStage < 3
            reversalStage := 3
            if showStageLabels
                label.new(bar_index, low, getStageText(3), style=label.style_label_up, color=color.new(getStageColor(3), 60), textcolor=getStageColor(3), size=labelSize)

    if sweepDirection == -1 and close < refCandleOpen
        stage3_cisd := true
        if reversalStage < 3
            reversalStage := 3
            if showStageLabels
                label.new(bar_index, high, getStageText(3), style=label.style_label_down, color=color.new(getStageColor(3), 60), textcolor=getStageColor(3), size=labelSize)

// ============================================================================
// STAGE 4 & 5 - New FVG and Breaker
// ============================================================================

// Stage 4: New FVG after CISD
if stage3_cisd and not stage4_newFVG
    if sweepDirection == 1 and bullishFVG
        stage4_newFVG := true
        if reversalStage < 4
            reversalStage := 4
            if showStageLabels
                label.new(bar_index, low, getStageText(4), style=label.style_label_up, color=color.new(getStageColor(4), 60), textcolor=getStageColor(4), size=labelSize)

    if sweepDirection == -1 and bearishFVG
        stage4_newFVG := true
        if reversalStage < 4
            reversalStage := 4
            if showStageLabels
                label.new(bar_index, high, getStageText(4), style=label.style_label_down, color=color.new(getStageColor(4), 60), textcolor=getStageColor(4), size=labelSize)

// Stage 5: Breaker (price breaks back through range)
if stage4_newFVG and not stage5_breaker
    if sweepDirection == 1 and close > rangeHigh
        stage5_breaker := true
        reversalStage := 5
        if showStageLabels
            label.new(bar_index, high, getStageText(5), style=label.style_label_down, color=color.new(getStageColor(5), 60), textcolor=getStageColor(5), size=labelSize)

    if sweepDirection == -1 and close < rangeLow
        stage5_breaker := true
        reversalStage := 5
        if showStageLabels
            label.new(bar_index, low, getStageText(5), style=label.style_label_up, color=color.new(getStageColor(5), 60), textcolor=getStageColor(5), size=labelSize)

// ============================================================================
// ENTRY/SL/TP VISUALIZATION
// ============================================================================

if showEntryLevels and reversalStage >= 3 and not na(sweepPrice)
    // Calculate levels
    currentEntry = close
    slPrice = sweepPrice
    stopDist = math.abs(currentEntry - slPrice)
    tpPrice = sweepDirection == 1 ? currentEntry + (stopDist * 2) : currentEntry - (stopDist * 2)

    // Update entry line
    if not na(entryLine)
        line.set_xy1(entryLine, bar_index - 10, currentEntry)
        line.set_xy2(entryLine, bar_index + 20, currentEntry)
    else
        entryLine := line.new(bar_index - 10, currentEntry, bar_index + 20, currentEntry, color=ENTRY_COLOR, style=line.style_solid, width=1, extend=extend.right)

    // Update SL line
    if not na(slLine)
        line.set_xy1(slLine, bar_index - 10, slPrice)
        line.set_xy2(slLine, bar_index + 20, slPrice)
    else
        slLine := line.new(bar_index - 10, slPrice, bar_index + 20, slPrice, color=SL_COLOR, style=line.style_dashed, width=1, extend=extend.right)

    // Update TP line
    if not na(tpLine)
        line.set_xy1(tpLine, bar_index - 10, tpPrice)
        line.set_xy2(tpLine, bar_index + 20, tpPrice)
    else
        tpLine := line.new(bar_index - 10, tpPrice, bar_index + 20, tpPrice, color=TP_COLOR, style=line.style_dashed, width=1, extend=extend.right)

    // Update labels
    if not na(entryLabel)
        label.set_xy(entryLabel, bar_index + 3, currentEntry)
    else
        entryLabel := label.new(bar_index + 3, currentEntry, "Entry", style=label.style_none, textcolor=ENTRY_COLOR, size=labelSize)

    if not na(slLabel)
        label.set_xy(slLabel, bar_index + 3, slPrice)
    else
        slLabel := label.new(bar_index + 3, slPrice, "SL", style=label.style_none, textcolor=SL_COLOR, size=labelSize)

    if not na(tpLabel)
        label.set_xy(tpLabel, bar_index + 3, tpPrice)
    else
        tpLabel := label.new(bar_index + 3, tpPrice, "TP (2R)", style=label.style_none, textcolor=TP_COLOR, size=labelSize)

// ============================================================================
// DASHBOARD PANEL
// ============================================================================

if showDashboard
    if na(dashboardTable)
        dashboardTable := table.new(position.bottom_right, 2, 6, bgcolor=DASH_BG, border_width=1, border_color=color.new(#374151, 50))

    // Header
    table.cell(dashboardTable, 0, 0, "TTrades Reversal", text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_left)
    table.merge_cells(dashboardTable, 0, 0, 1, 0)

    // Bias
    biasText = sweepDirection == 1 ? "BULLISH" : sweepDirection == -1 ? "BEARISH" : "NEUTRAL"
    biasColor = sweepDirection == 1 ? DASH_BULLISH : sweepDirection == -1 ? DASH_BEARISH : DASH_NEUTRAL
    table.cell(dashboardTable, 0, 1, "Bias:", text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashboardTable, 1, 1, biasText, text_color=biasColor, text_size=dashSize, text_halign=text.align_right)

    // Stage
    stageText = str.tostring(reversalStage) + "/5"
    stageColor = reversalStage >= 3 ? DASH_BULLISH : DASH_NEUTRAL
    table.cell(dashboardTable, 0, 2, "Stage:", text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashboardTable, 1, 2, stageText, text_color=stageColor, text_size=dashSize, text_halign=text.align_right)

    // Range
    rangeText = rangeSet ? str.tostring(rangeLow, "#.##") + " - " + str.tostring(rangeHigh, "#.##") : "Building..."
    table.cell(dashboardTable, 0, 3, "Range:", text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashboardTable, 1, 3, rangeText, text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_right)

    // Sweep
    sweepText = not na(sweepPrice) ? str.tostring(sweepPrice, "#.##") : "-"
    table.cell(dashboardTable, 0, 4, "Sweep:", text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashboardTable, 1, 4, sweepText, text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_right)

    // Equilibrium
    eqText = rangeSet ? str.tostring((rangeHigh + rangeLow) / 2, "#.##") : "-"
    table.cell(dashboardTable, 0, 5, "EQ:", text_color=DASH_TEXT, text_size=dashSize, text_halign=text.align_left)
    table.cell(dashboardTable, 1, 5, eqText, text_color=color.new(#8B5CF6, 0), text_size=dashSize, text_halign=text.align_right)

// ============================================================================
// END OF SCRIPT
// ============================================================================
