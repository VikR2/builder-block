//@version=5
indicator(title='Thisisit', shorttitle='M3', overlay=true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

ticker = syminfo.ticker

// timezone = "America/New_York"
timezone = input.string('GMT-5', title='Timezone', options=['GMT-11', 'GMT-10', 'GMT-9', 'GMT-8', 'GMT-7', 'GMT-6', 'GMT-5', 'GMT-4', 'GMT-3', 'GMT-2', 'GMT-1', 'GMT', 'GMT+1', 'GMT+2', 'GMT+3', 'GMT+4', 'GMT+5', 'GMT+6', 'GMT+7', 'GMT+8', 'GMT+9', 'GMT+10', 'GMT+11', 'GMT+12'], tooltip='e.g. \'America/New_York\', \'Asia/Tokyo\', \'GMT-4\', \'GMT+9\'...') //, group='General')

// =============================================================================
// ALERT SETTINGS
// =============================================================================
GRP_ALERTS = "Alert Settings"
alertSRLevelsEnabled = input.bool(true, "Alert SR Levels at 7:00 AM", group=GRP_ALERTS)
alertTargetHitEnabled = input.bool(true, "Alert When Target Hit", group=GRP_ALERTS)
alertSummaryEnabled = input.bool(true, "Alert Summary After 9:20", group=GRP_ALERTS)
target1STDMultiplier = input.float(1.0, "Target 1 STD Multiplier", step=0.1, group=GRP_ALERTS)
target2STDMultiplier = input.float(1.5, "Target 2 STD Multiplier", step=0.1, group=GRP_ALERTS)
biasThreshold = input.float(title="Bias Threshold", defval=0, step=0.001, group=GRP_ALERTS, tooltip="Same as TCM-Bias threshold")

// =============================================================================
// TEST MODE - Manual triggers (disable after testing)
// =============================================================================
GRP_TEST = "Test Mode"
testSendLevels = input.bool(false, "📤 TEST: Send SR Levels Now", group=GRP_TEST, tooltip="Enable to send SR levels alert now. Disable after sending.")
testSendSummary = input.bool(false, "📤 TEST: Send Summary Now", group=GRP_TEST, tooltip="Enable to send target status summary now. Disable after sending.")
testSimple = input.bool(false, "🔔 TEST: Simple Ping", group=GRP_TEST, tooltip="Enable to send a simple test alert. Use this to verify alerts are working.")
testForce = input.bool(false, "🔴 FORCE TEST (instant)", group=GRP_TEST, tooltip="Fires EVERY tick while enabled. Turn off immediately after testing!")
testForceLevels = input.bool(false, "🔴 FORCE: 7AM SR Levels (instant)", group=GRP_TEST, tooltip="Sends 7 AM SR Levels report INSTANTLY. Turn off immediately!")
testForceSummary = input.bool(false, "🔴 FORCE: 9:20 Summary (instant)", group=GRP_TEST, tooltip="Sends 9:20 AM Summary report INSTANTLY. Turn off immediately!")

// Test alert - matches TCM-Bias.pine pattern exactly
triggerOnBar = barstate.isconfirmed
if (testSimple and triggerOnBar)
    alert('{"content": "TCM TEST PING - Alerts are working!"}', alert.freq_once_per_bar)

// Force test - fires immediately on every tick (turn off quickly!)
if testForce
    alert('{"content": "FORCE TEST - Discord webhook is working!"}', alert.freq_all)

// =============================================================================
// BIAS CALCULATION (from TCM-Bias.pine)
// =============================================================================
getBiasDiff() =>
    yesterday = request.security(syminfo.tickerid, 'D', close[1], lookahead=barmerge.lookahead_on)
    today = request.security(syminfo.tickerid, 'D', close, lookahead=barmerge.lookahead_on)
    delta = today - yesterday
    percentage = delta / yesterday
    percentage

biasDiff = getBiasDiff()

var bool buying = na
buying := biasDiff > biasThreshold ? true : biasDiff < -biasThreshold ? false : buying

gapTime = "1140-1240"

hideGap = input.bool(false, "Hide the Gap")


// InSession() returns 'true' when the current bar happens inside
// the specified session, corrected for the given time zone (optional).
// Returns 'false' when the bar doesn't happen in that time period,
// or when the chart's time frame is 1 day or higher. 
InSession(sessionTime, sessionTimeZone=syminfo.timezone, exact=false) =>
    if exact
        not na(time("1", sessionTime, sessionTimeZone))
    else
        not na(time(timeframe.period, sessionTime, sessionTimeZone))


duringGap = InSession(gapTime, timezone)

// plotcandle(open, high, low, close, title='Hidden bar color', color=duringGap and hideGap ? color.new(#131722, 0) : na, wickcolor = duringGap and hideGap ? color.new(#131722, 0) : na, bordercolor=duringGap and hideGap ? color.new(#131722,0) : na, display = display.all)
plotcandle(open, high, low, close, title='Hidden bar color', color=duringGap and hideGap ? chart.bg_color : na, wickcolor = duringGap and hideGap ?  chart.bg_color : na, bordercolor=duringGap and hideGap ? chart.bg_color : na, display = display.all)

// Overnight session

// STEP 1:
// Define custom session trading times with inputs
// ONsessionTime = input.session("0400-0815", title="Session time")
showONSession = input.bool(true, "Plot Daily Liquidity Range")

ONsessionTime = "1240-1520"
ONsessionZone = timezone

// Other inputs for the boxes' visual appearance
ONSessionBorderSize   = input.int(1, title="Accumulation border size", minval=0)
ONSessionBgColor      = input.color(color.new(color.rgb(248,248,242), 85), title="Accumulation Background Color")
ONSessionBorderColor   = input.color(color.rgb(10, 10, 0), title="Accumulation border Color")
ONSessionAvgLineColor  = input.color(color.rgb(15, 15, 0), title="Liquidity range Avg Price Color")
// Create variables
var ONsessionHighPrice = 0.0
var ONsessionLowPrice  = 0.0
var ONsessionOpenPrice = 0.0
var ONSessionAvgPrice  = 0.0
var ONSessionPipCount  = 0
var box ONsessionBox = na
var line ONSessionAvgLine = na
var label ONSessionAvgLabel = na
var label ONSessionLabel = na
// var table testtable = na

// =============================================================================
// PREVIOUS DAY SR LEVELS (for alerts - built 12:40-3:20 PM yesterday)
// =============================================================================
var float prevDaySRHigh = 0.0
var float prevDaySRLow = 0.0
var int prevDaySRRange = 0

// =============================================================================
// TARGET HIT TRACKING
// =============================================================================
var bool longT1Hit = false
var bool longT2Hit = false
var bool shortT1Hit = false
var bool shortT2Hit = false

// Alert tracking
var bool alertedSRLevels = false
var bool alertedSummary = false

// Reset target tracking on new day
if ta.change(time("D")) != 0
    longT1Hit := false
    longT2Hit := false
    shortT1Hit := false
    shortT2Hit := false
    alertedSRLevels := false
    alertedSummary := false

// STEP 2:
// See if the session is currently active and just started
inONSession    = InSession(ONsessionTime, ONsessionZone) and timeframe.isintraday
ONsessionStart = inONSession and not inONSession[1]

// STEP 3:
// When a new session starts, set the session high and low to the data
// of the bar in the session.
if ONsessionStart
    ONsessionHighPrice := high
    ONsessionLowPrice  := low
    ONsessionOpenPrice := open
    ONSessionAvgPrice  := (ONsessionHighPrice + ONsessionLowPrice) / 2
    ONSessionPipCount  := int(math.abs((ONsessionHighPrice - ONsessionLowPrice) / syminfo.mintick))

// Else, during the session, track the highest high and lowest low
else if inONSession
    ONsessionHighPrice := math.max(ONsessionHighPrice, high)
    ONsessionLowPrice  := math.min(ONsessionLowPrice, low)
    ONSessionAvgPrice  := (ONsessionHighPrice + ONsessionLowPrice) / 2
    ONSessionPipCount  := int(math.abs((ONsessionHighPrice - ONsessionLowPrice) / syminfo.mintick))

// Save SR levels when session ends (for use as "previous day" levels)
ONsessionEnd = not inONSession and inONSession[1]
if ONsessionEnd and ONsessionHighPrice > 0
    prevDaySRHigh := ONsessionHighPrice
    prevDaySRLow := ONsessionLowPrice
    prevDaySRRange := ONSessionPipCount

// =============================================================================
// FORCE SR LEVELS REPORT - Fires instantly with current data
// =============================================================================
if testForceLevels
    // Use previous day SR if available, otherwise use current session
    forceSRHigh = prevDaySRHigh > 0 ? prevDaySRHigh : ONsessionHighPrice
    forceSRLow = prevDaySRLow > 0 ? prevDaySRLow : ONsessionLowPrice
    forceSRRange = prevDaySRRange > 0 ? prevDaySRRange : ONSessionPipCount

    if forceSRHigh > 0
        // Calculate targets
        forceLongT1 = forceSRHigh + ((forceSRHigh - forceSRLow) * target1STDMultiplier)
        forceLongT2 = forceSRHigh + ((forceSRHigh - forceSRLow) * target2STDMultiplier)
        forceShortT1 = forceSRLow - ((forceSRHigh - forceSRLow) * target1STDMultiplier)
        forceShortT2 = forceSRLow - ((forceSRHigh - forceSRLow) * target2STDMultiplier)

        // Emojis for Discord
        fBiasIcon = buying ? "🟢" : "🔴"
        fBiasArrow = buying ? "▲" : "▼"
        fBiasText = buying ? "BULLISH" : "BEARISH"
        fSrSource = (prevDaySRHigh > 0) ? "" : " (using current SR)"

        fMsg = "🔴 [INSTANT] " + fBiasIcon + " " + ticker + " " + fBiasArrow + " " + fBiasText + fSrSource + "\\n"
        fMsg += "━━━━━━━━━━━━━━━━━━━━\\n"
        fMsg += "◾ **SR LEVELS**\\n"
        fMsg += "High: " + str.tostring(forceSRHigh, "#.##") + "\\n"
        fMsg += "Low: " + str.tostring(forceSRLow, "#.##") + "\\n"
        fMsg += "Range: " + str.tostring(forceSRRange) + " pts\\n"
        fMsg += "━━━━━━━━━━━━━━━━━━━━\\n"

        if buying
            fMsg += "◾ **TARGETS (LONG)**\\n"
            fMsg += "T1 (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(forceLongT1, "#.##") + "\\n"
            fMsg += "T2 (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(forceLongT2, "#.##") + "\\n"
            fMsg += "━━━━━━━━━━━━━━━━━━━━\\n"
            fMsg += "◾ **REVERSAL ZONE**\\n"
            fMsg += "MAX Low (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(forceShortT1, "#.##") + "\\n"
            fMsg += "MAX Low (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(forceShortT2, "#.##") + " → SCALP LONG"
        else
            fMsg += "◾ **TARGETS (SHORT)**\\n"
            fMsg += "T1 (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(forceShortT1, "#.##") + "\\n"
            fMsg += "T2 (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(forceShortT2, "#.##") + "\\n"
            fMsg += "━━━━━━━━━━━━━━━━━━━━\\n"
            fMsg += "◾ **REVERSAL ZONE**\\n"
            fMsg += "MAX High (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(forceLongT1, "#.##") + "\\n"
            fMsg += "MAX High (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(forceLongT2, "#.##") + " → SCALP SHORT"

        alert('{"content": "' + fMsg + '"}', alert.freq_once_per_bar)

// =============================================================================
// FORCE 9:20 SUMMARY REPORT - Fires instantly with current target status
// =============================================================================
if testForceSummary
    // Use previous day SR if available, otherwise use current session
    fsSRHigh = prevDaySRHigh > 0 ? prevDaySRHigh : ONsessionHighPrice
    fsSRLow = prevDaySRLow > 0 ? prevDaySRLow : ONsessionLowPrice

    if fsSRHigh > 0
        // Calculate targets for display
        fsLongT1 = fsSRHigh + ((fsSRHigh - fsSRLow) * target1STDMultiplier)
        fsLongT2 = fsSRHigh + ((fsSRHigh - fsSRLow) * target2STDMultiplier)
        fsShortT1 = fsSRLow - ((fsSRHigh - fsSRLow) * target1STDMultiplier)
        fsShortT2 = fsSRLow - ((fsSRHigh - fsSRLow) * target2STDMultiplier)

        // Emojis for Discord
        fsBiasIcon = buying ? "🟢" : "🔴"
        fsBiasArrow = buying ? "▲" : "▼"
        fsBiasText = buying ? "BULLISH" : "BEARISH"

        fsMsg = "🔴 [INSTANT] " + fsBiasIcon + " " + ticker + " " + fsBiasArrow + " " + fsBiasText + "\\n"
        fsMsg += "━━━━━━━━━━━━━━━━━━━━\\n"
        fsMsg += "◾ **9:20 AM SUMMARY**\\n"

        // Show status based on bias direction
        if buying
            fsLongT1Status = longT1Hit ? "✅ HIT" : "⬜ NOT HIT"
            fsLongT2Status = longT2Hit ? "✅ HIT" : "⬜ NOT HIT"
            fsShortT1Status = shortT1Hit ? "✅ HIT" : "⬜ NOT HIT"
            fsShortT2Status = shortT2Hit ? "✅ HIT" : "⬜ NOT HIT"

            fsMsg += "**Primary Targets (Long)**\\n"
            fsMsg += "T1 (" + str.tostring(target1STDMultiplier) + " STD) @ " + str.tostring(fsLongT1, "#.##") + ": " + fsLongT1Status + "\\n"
            fsMsg += "T2 (" + str.tostring(target2STDMultiplier) + " STD) @ " + str.tostring(fsLongT2, "#.##") + ": " + fsLongT2Status
            if longT2Hit
                fsMsg += " → SCALP SHORT"
            fsMsg += "\\n"
            fsMsg += "━━━━━━━━━━━━━━━━━━━━\\n"
            fsMsg += "**Reversal Zone**\\n"
            fsMsg += "MAX Low (" + str.tostring(target1STDMultiplier) + " STD) @ " + str.tostring(fsShortT1, "#.##") + ": " + fsShortT1Status + "\\n"
            fsMsg += "MAX Low (" + str.tostring(target2STDMultiplier) + " STD) @ " + str.tostring(fsShortT2, "#.##") + ": " + fsShortT2Status
            if shortT2Hit
                fsMsg += "\\n→ 🎯 SCALP LONG opportunity"
        else
            fsShortT1Status = shortT1Hit ? "✅ HIT" : "⬜ NOT HIT"
            fsShortT2Status = shortT2Hit ? "✅ HIT" : "⬜ NOT HIT"
            fsLongT1Status = longT1Hit ? "✅ HIT" : "⬜ NOT HIT"
            fsLongT2Status = longT2Hit ? "✅ HIT" : "⬜ NOT HIT"

            fsMsg += "**Primary Targets (Short)**\\n"
            fsMsg += "T1 (" + str.tostring(target1STDMultiplier) + " STD) @ " + str.tostring(fsShortT1, "#.##") + ": " + fsShortT1Status + "\\n"
            fsMsg += "T2 (" + str.tostring(target2STDMultiplier) + " STD) @ " + str.tostring(fsShortT2, "#.##") + ": " + fsShortT2Status
            if shortT2Hit
                fsMsg += " → SCALP LONG"
            fsMsg += "\\n"
            fsMsg += "━━━━━━━━━━━━━━━━━━━━\\n"
            fsMsg += "**Reversal Zone**\\n"
            fsMsg += "MAX High (" + str.tostring(target1STDMultiplier) + " STD) @ " + str.tostring(fsLongT1, "#.##") + ": " + fsLongT1Status + "\\n"
            fsMsg += "MAX High (" + str.tostring(target2STDMultiplier) + " STD) @ " + str.tostring(fsLongT2, "#.##") + ": " + fsLongT2Status
            if longT2Hit
                fsMsg += "\\n→ 🎯 SCALP SHORT opportunity"

        alert('{"content": "' + fsMsg + '"}', alert.freq_once_per_bar)

// STEP 4:
// When a session begins, make a new box for that session
if ONsessionStart and showONSession
    ONsessionBox := box.new(left=bar_index, top=na, right=na, bottom=na,
         border_width=ONSessionBorderSize)
    // ONSessionAvgLine := line.new(bar_index, ONSessionAvgPrice, bar_index + 1, ONSessionAvgPrice, color = color.navy, width = 3)
    tsStart = timestamp(timezone,year(time), month(time), dayofmonth(time), 12,40 )
    tsEnd   = timestamp(timezone,year(time), month(time), dayofmonth(time), 39,20 )
    ONSessionAvgLine := line.new(tsStart, ONSessionAvgPrice, tsEnd, ONSessionAvgPrice, color = ONSessionAvgLineColor, width = 2, xloc = xloc.bar_time, style = line.style_solid)
    ONSessionAvgLabel := label.new(tsEnd-3000000, ONSessionAvgPrice*0.99998, "", xloc = xloc.bar_time, style = label.style_none, textcolor = ONSessionAvgLineColor, size = size.small, textalign = text.align_left)
    ONSessionLabel    := label.new(tsStart+1000000, ONsessionHighPrice, str.tostring(ONSessionPipCount) + " pts", xloc = xloc.bar_time, style = label.style_none, textcolor = ONSessionBorderColor, size = size.small, textalign = text.align_right)
    // line.set_color()
    // testtable := table.new(position.bottom_right,1,1)
    // table.cell(testtable, 1,1, "aaa")



// STEP 5:
// During the session, update that session's existing box
if inONSession and showONSession
    box.set_top(ONsessionBox, ONsessionHighPrice)
    box.set_bottom(ONsessionBox, ONsessionLowPrice)

    box.set_right(ONsessionBox, bar_index + 1)

    line.set_y1(ONSessionAvgLine, ONSessionAvgPrice)
    line.set_y2(ONSessionAvgLine, ONSessionAvgPrice)
    label.set_y(ONSessionAvgLabel,ONSessionAvgPrice)
    label.set_y(ONSessionLabel, ONsessionHighPrice)

    label.set_text(ONSessionLabel,str.tostring(ONSessionPipCount) + " pts")// " + str.tostring(syminfo.mintick))
    // label.set_y(ONSessionLabel,ONsessionHighPrice)
    // line.set_xy1(ONSessionAvgLine, bar_index + 1, ONSessionAvgPrice)
    // line.set_y2(ONSessionAvgLine, ONSessionAvgPrice)
    // l = label.new(bar_index, close, str.tostring(ONSessionAvgPrice))

    // See if bar closed higher than session open. When it did, make
    // box green (and use red otherwise).
    box.set_bgcolor(ONsessionBox, ONSessionBgColor)
    box.set_border_color(ONsessionBox, ONSessionBorderColor)
    // if close > ONsessionOpenPrice
    //     box.set_bgcolor(ONsessionBox, upBoxColor)
    //     box.set_border_color(ONsessionBox, upBorderColor)
    // else
    //     box.set_bgcolor(ONsessionBox, downBoxColor)
    //     box.set_border_color(ONsessionBox, downBorderColor)
    // avgPrice = math.abs(ONsessionHighPrice - ONsessionLowPrice) / 2

// =============================================================================
// STD TARGET CALCULATIONS (using PREVIOUS DAY's SR levels)
// =============================================================================
// Use previous day's SR levels for targets (built 12:40-3:20 PM yesterday)
srHigh = prevDaySRHigh
srLow = prevDaySRLow
srRange = srHigh - srLow

// Calculate 1STD and 1.5STD targets
longT1Price = srHigh + (srRange * target1STDMultiplier)
longT2Price = srHigh + (srRange * target2STDMultiplier)
shortT1Price = srLow - (srRange * target1STDMultiplier)
shortT2Price = srLow - (srRange * target2STDMultiplier)

// ONLiqHunt

ONLiqHuntTime = "0920-1140"
showONLiqHuntTime = input.bool(true, "Monday Time")


ONLiqHuntBorderSize   = input.int(1, title="Monday border size", minval=0)
ONLiqHuntBgColor      = input.color(color.new(color.rgb(189,147,249), 85), title="Monday Background Color")
ONLiqHuntBorderColor   = input.color(color.rgb(24, 18, 32), title="Monday border Color")

// Create variables
var ONLiqHuntHighPrice = 0.0
var ONLiqHuntLowPrice  = 0.0
var ONLiqHuntOpenPrice = 0.0
var box ONLiqHuntBox = na
// var label ONLiqLabel = na

inONLiqHunt    = InSession(ONLiqHuntTime, timezone) and timeframe.isintraday
ONLiqHuntStart = inONLiqHunt and not inONLiqHunt[1]

// When a new session starts, set the session high and low to the data
// of the bar in the session.
if ONLiqHuntStart
    ONLiqHuntHighPrice := high
    ONLiqHuntLowPrice  := low
    ONLiqHuntOpenPrice := open
// Else, during the session, track the highest high and lowest low
else if inONLiqHunt
    ONLiqHuntHighPrice := math.max(ONLiqHuntHighPrice, high)
    ONLiqHuntLowPrice  := math.min(ONLiqHuntLowPrice, low)

// When a session begins, make a new box for that session
if ONLiqHuntStart and showONLiqHuntTime
    ONLiqHuntBox := box.new(left=bar_index, top=na, right=na, bottom=na,
         border_width=ONLiqHuntBorderSize)
    tsStart = timestamp(timezone,year(time), month(time), dayofmonth(time), 15,20 )
    // ONLiqLabel    := label.new(tsStart+300000, ONLiqHuntHighPrice, "Liquidity Hunt", xloc = xloc.bar_time, style = label.style_none, textcolor = ONLiqHuntBorderColor, size = size.small, textalign = text.align_right)

// During the session, update that session's existing box
if inONLiqHunt and showONLiqHuntTime
    box.set_top(ONLiqHuntBox, ONLiqHuntHighPrice)
    box.set_bottom(ONLiqHuntBox, ONLiqHuntLowPrice)

    box.set_right(ONLiqHuntBox, bar_index + 1)

    box.set_bgcolor(ONLiqHuntBox, ONLiqHuntBgColor)
    box.set_border_color(ONLiqHuntBox, ONLiqHuntBorderColor)
    // label.set_y(ONLiqLabel,ONLiqHuntHighPrice)


// offset time

// STEP 1:
// Define custom session trading times with inputs
showOffsetTime = input.bool(true, "Tuesday Time")

OffsetTime = "1640-2340"

// Other inputs for the boxes' visual appearance
OffsetBorderSize   = input.int(1, title="Tuesday border size", minval=0)
OffsetBgColor      = input.color(color.new(#2F4F4F, 85), title="Tuesday Background Color")
OffsetBorderColor   = input.color(#2F4F4F, title="Tuesday border Color")

// Create variables
var OffsetHighPrice = 0.0
var OffsetLowPrice  = 0.0
var OffsetOpenPrice = 0.0
var box OffsetBox = na

// STEP 2:
// See if the session is currently active and just started
inOffset    = InSession(OffsetTime, timezone) and timeframe.isintraday
OffsetStart = inOffset and not inOffset[1]

// STEP 3:
// When a new session starts, set the session high and low to the data
// of the bar in the session.
if OffsetStart
    OffsetHighPrice := high
    OffsetLowPrice  := low
    OffsetOpenPrice := open
// Else, during the session, track the highest high and lowest low
else if inOffset
    OffsetHighPrice := math.max(OffsetHighPrice, high)
    OffsetLowPrice  := math.min(OffsetLowPrice, low)

// STEP 4:
// When a session begins, make a new box for that session
if OffsetStart and showOffsetTime
    OffsetBox := box.new(left=bar_index, top=na, right=na, bottom=na,
         border_width=OffsetBorderSize)

// STEP 5:
// During the session, update that session's existing box
if inOffset and showOffsetTime
    box.set_top(OffsetBox, OffsetHighPrice)
    box.set_bottom(OffsetBox, OffsetLowPrice)

    box.set_right(OffsetBox, bar_index + 1)

    box.set_bgcolor(OffsetBox, OffsetBgColor)
    box.set_border_color(OffsetBox, OffsetBorderColor)

// rebalance

RebalanceTime = "0200-0440"
showRebalanceTime = input.bool(true, "Wednesday Time")


RebalanceBorderSize   = input.int(1, title="Wednesday border size", minval=0)
RebalanceBgColor      = input.color(color.new(color.rgb(0,91,91), 85), title="Wednesday Background Color")
RebalanceBorderColor   = input.color(color.rgb(0,91,91), title="Wednesday border Color")

// Create variables
var RebalanceHighPrice = 0.0
var RebalanceLowPrice  = 0.0
var RebalanceOpenPrice = 0.0
var box RebalanceBox = na

inRebalance    = InSession(RebalanceTime, timezone) and timeframe.isintraday
RebalanceStart = inRebalance and not inRebalance[1]

// When a new session starts, set the session high and low to the data
// of the bar in the session.
if RebalanceStart
    RebalanceHighPrice := high
    RebalanceLowPrice  := low
    RebalanceOpenPrice := open
// Else, during the session, track the highest high and lowest low
else if inRebalance
    RebalanceHighPrice := math.max(RebalanceHighPrice, high)
    RebalanceLowPrice  := math.min(RebalanceLowPrice, low)

// When a session begins, make a new box for that session
if RebalanceStart and showRebalanceTime
    RebalanceBox := box.new(left=bar_index, top=na, right=na, bottom=na,
         border_width=RebalanceBorderSize)

// During the session, update that session's existing box
if inRebalance and showRebalanceTime
    box.set_top(RebalanceBox, RebalanceHighPrice)
    box.set_bottom(RebalanceBox, RebalanceLowPrice)

    box.set_right(RebalanceBox, bar_index + 1)

