// Custom Session 1
showCustomSession1 = input.bool(true, "Plot Liquidity Targets")

CustomSession1Time = input.session("1640-1940", title="True daily Range")


CustomSession1StdevNmbr = input.int(1, "Daily Range Number of Projections", minval = 1)
showCustomSession1Midlvl = input.bool(true, "Show the mid-levels of the projections")

CustomSession1BorderSize   = input.int(1, title="Custom Session 1 Box border size", minval=0)
CustomSession1BgColor      = input.color(color.new(color.rgb(249, 147, 245), 85), title="Custom Session 1 Background Color")
CustomSession1BorderColor   = input.color(color.rgb(9, 10, 1), title="Custom Session 1 border Color")

// Create variables
var CustomSession1HighPrice = 0.0
var CustomSession1LowPrice  = 0.0
var CustomSession1OpenPrice = 0.0
var CustomSession1AvgPrice  = 0.0
var stdv1                   = 0.0


var firstIndex = 0

var array<float> stdvCustomSession1stdvs = na
var array<line> stdvCustomSession1stdvsLines = na

var box CustomSession1Box = na

inCustomSession1    = InSession(CustomSession1Time, timezone) and timeframe.isintraday
CustomSession1Start = inCustomSession1 and not inCustomSession1[1]

if CustomSession1Start
    CustomSession1HighPrice := high
    CustomSession1LowPrice  := low
    CustomSession1OpenPrice := open
    CustomSession1AvgPrice  := (high + low)/2
    firstIndex := bar_index
    stdvCustomSession1stdvs      := array.new_float(CustomSession1StdevNmbr * 4)
    stdvCustomSession1stdvsLines := array.new_line(CustomSession1StdevNmbr * 4)  
else if inCustomSession1
    CustomSession1HighPrice := math.max(CustomSession1HighPrice, high)
    CustomSession1LowPrice  := math.min(CustomSession1LowPrice, low)
    stdv1                   := CustomSession1HighPrice - CustomSession1LowPrice
    CustomSession1AvgPrice  := (CustomSession1HighPrice + CustomSession1LowPrice)/2

    
    i = 0
    while i < CustomSession1StdevNmbr * 4
        if i == 0
            array.set(stdvCustomSession1stdvs, i, CustomSession1HighPrice + stdv1/2)
            array.set(stdvCustomSession1stdvs, i + 1, CustomSession1HighPrice + stdv1)
            array.set(stdvCustomSession1stdvs, i + 2, CustomSession1LowPrice - stdv1/2)
            array.set(stdvCustomSession1stdvs, i + 3, CustomSession1LowPrice - stdv1)
        else
            array.set(stdvCustomSession1stdvs, i, array.get(stdvCustomSession1stdvs,i-4) + stdv1)
            array.set(stdvCustomSession1stdvs, i + 1, array.get(stdvCustomSession1stdvs,i-3) + stdv1)
            array.set(stdvCustomSession1stdvs, i + 2, array.get(stdvCustomSession1stdvs,i-2) - stdv1)
            array.set(stdvCustomSession1stdvs, i + 3, array.get(stdvCustomSession1stdvs,i-1) - stdv1)
        i += 4
    // l = label.new(bar_index, close, str.tostring(stdvCustomSession1stdvs))

if CustomSession1Start and showCustomSession1
    CustomSession1Box := box.new(left=bar_index, top=na, right=na, bottom=na,border_width=CustomSession1BorderSize)

    for i = 0 to array.size(stdvCustomSession1stdvsLines) - 1
        array.set(stdvCustomSession1stdvsLines, i,line.new(bar_index,array.get(stdvCustomSession1stdvs,i),bar_index+1,array.get(stdvCustomSession1stdvs,i),color =  CustomSession1BorderColor))
    


if inCustomSession1 and showCustomSession1
    box.set_top(CustomSession1Box, CustomSession1HighPrice)
    box.set_bottom(CustomSession1Box, CustomSession1LowPrice)

    box.set_right(CustomSession1Box, bar_index + 1)

    box.set_bgcolor(CustomSession1Box, CustomSession1BgColor)
    box.set_border_color(CustomSession1Box, CustomSession1BorderColor)

    for i = 0 to array.size(stdvCustomSession1stdvsLines) - 1
        if i % 2 == 0
            if(showCustomSession1Midlvl)
                line.set_xy1(array.get(stdvCustomSession1stdvsLines,i), (bar_index + firstIndex)  /2 - 1 ,  array.get(stdvCustomSession1stdvs,i))
                line.set_xy2(array.get(stdvCustomSession1stdvsLines,i), (bar_index + firstIndex)  /2 + 1, array.get(stdvCustomSession1stdvs,i) )
        else
            line.set_y1(array.get(stdvCustomSession1stdvsLines,i),  array.get(stdvCustomSession1stdvs,i))
            line.set_xy2(array.get(stdvCustomSession1stdvsLines,i), bar_index + 1, array.get(stdvCustomSession1stdvs,i) )


// Custom Session 2
showCustomSession2 = input.bool(true, "Plot AM Scalp target")

CustomSession2Time = input.session("0200-0700", title="AM Scalping Target")


CustomSession2StdevNmbr = input.int(2, "Number of Scalp targets", minval = 1)
showCustomSession2Midlvl = input.bool(true, "Show the mid-levels of the projections")

CustomSession2BorderSize   = input.int(1, title=" Border size", minval=0)
CustomSession2BgColor      = input.color(color.new(#d30606, 85), title="Background Color")
CustomSession2BorderColor   = input.color(color.rgb(153, 5, 5), title="Border Color")

// Create variables
var CustomSession2HighPrice = 0.0
var CustomSession2LowPrice  = 0.0
var CustomSession2OpenPrice = 0.0
var CustomSession2AvgPrice  = 0.0
// var stdv1                   = 0.0


// var firstIndex = 0

var array<float> stdvCustomSession2stdvs = na
var array<line> stdvCustomSession2stdvsLines = na

var box CustomSession2Box = na

inCustomSession2    = InSession(CustomSession2Time, timezone) and timeframe.isintraday
CustomSession2Start = inCustomSession2 and not inCustomSession2[1]

if CustomSession2Start
    CustomSession2HighPrice := high
    CustomSession2LowPrice  := low
    CustomSession2OpenPrice := open
    CustomSession2AvgPrice  := (high + low)/2
    firstIndex := bar_index
    stdvCustomSession2stdvs      := array.new_float(CustomSession2StdevNmbr * 4)
    stdvCustomSession2stdvsLines := array.new_line(CustomSession2StdevNmbr * 4)    
else if inCustomSession2
    CustomSession2HighPrice := math.max(CustomSession2HighPrice, high)
    CustomSession2LowPrice  := math.min(CustomSession2LowPrice, low)
    stdv1                   := CustomSession2HighPrice - CustomSession2LowPrice
    CustomSession2AvgPrice  := (CustomSession2HighPrice + CustomSession2LowPrice)/2

    
    i = 0
    while i < CustomSession2StdevNmbr * 4
        if i == 0
            array.set(stdvCustomSession2stdvs, i, CustomSession2HighPrice + stdv1/2)
            array.set(stdvCustomSession2stdvs, i + 1, CustomSession2HighPrice + stdv1)
            array.set(stdvCustomSession2stdvs, i + 2, CustomSession2LowPrice - stdv1/2)
            array.set(stdvCustomSession2stdvs, i + 3, CustomSession2LowPrice - stdv1)
        else
            array.set(stdvCustomSession2stdvs, i, array.get(stdvCustomSession2stdvs,i-4) + stdv1)
            array.set(stdvCustomSession2stdvs, i + 1, array.get(stdvCustomSession2stdvs,i-3) + stdv1)
            array.set(stdvCustomSession2stdvs, i + 2, array.get(stdvCustomSession2stdvs,i-2) - stdv1)
            array.set(stdvCustomSession2stdvs, i + 3, array.get(stdvCustomSession2stdvs,i-1) - stdv1)
        i += 4

if CustomSession2Start and showCustomSession2
    CustomSession2Box := box.new(left=bar_index, top=na, right=na, bottom=na,border_width=CustomSession2BorderSize)

    for i = 0 to array.size(stdvCustomSession2stdvsLines) - 1
        array.set(stdvCustomSession2stdvsLines, i,line.new(bar_index,array.get(stdvCustomSession2stdvs,i),bar_index+1,array.get(stdvCustomSession2stdvs,i),color =  CustomSession2BorderColor))
    

if inCustomSession2 and showCustomSession2
    box.set_top(CustomSession2Box, CustomSession2HighPrice)
    box.set_bottom(CustomSession2Box, CustomSession2LowPrice)

    box.set_right(CustomSession2Box, bar_index + 1)

    box.set_bgcolor(CustomSession2Box, CustomSession2BgColor)
    box.set_border_color(CustomSession2Box, CustomSession2BorderColor)

    for i = 0 to array.size(stdvCustomSession2stdvsLines) - 1
        if i % 2 == 0
            if(showCustomSession2Midlvl)
                line.set_xy1(array.get(stdvCustomSession2stdvsLines,i), (bar_index + firstIndex)  /2 - 1 ,  array.get(stdvCustomSession2stdvs,i))
                line.set_xy2(array.get(stdvCustomSession2stdvsLines,i), (bar_index + firstIndex)  /2 + 1, array.get(stdvCustomSession2stdvs,i) )
        else
            line.set_y1(array.get(stdvCustomSession2stdvsLines,i),  array.get(stdvCustomSession2stdvs,i))
            line.set_xy2(array.get(stdvCustomSession2stdvsLines,i), bar_index + 1, array.get(stdvCustomSession2stdvs,i) )


// Custom Session 3
showCustomSession3 = input.bool(true, "Plot PM Scalp target")
CustomSession3Time = input.session("1240-1520", title="Custom Session 3 Time")

session3CustomAnchored = input.bool(false, "Anchor Custom Session 3 @ custom Time")
CustomSession3AchorTime = input.session("0815-1600", title="Custom Anchor time Session 3")

CustomSession3StdevNmbr = input.int(2, "Custom Session 3 Number of Projections", minval = 1)
showCustomSession3Midlvl = input.bool(true, "Show the mid-levels of the projections")

CustomSession3BorderSize   = input.int(1, title="Custom Session 3 Box border size", minval=0)
CustomSession3BgColor      = input.color(color.new(#f3f1f4, 85), title="Custom Session 3 Background Color")
CustomSession3BorderColor   = input.color(color.rgb(6, 1, 18), title="Custom Session 3 border Color")

// Create variables
var CustomSession3HighPrice = 0.0
var CustomSession3LowPrice  = 0.0
var CustomSession3OpenPrice = 0.0
var CustomSession3AvgPrice  = 0.0
var CustomSession3AnchorOpenPrice = 0.0
// var stdv1                   = 0.0


// var firstIndex = 0

var array<float> stdvCustomSession3stdvs = na
var array<line> stdvCustomSession3stdvsLines = na

var box CustomSession3Box = na

inCustomSession3    = InSession(CustomSession3Time, timezone) and timeframe.isintraday
CustomSession3Start = inCustomSession3 and not inCustomSession3[1]

if CustomSession3Start
    CustomSession3HighPrice := high
    CustomSession3LowPrice  := low
    CustomSession3OpenPrice := open
    CustomSession3AvgPrice  := (high + low)/2
    firstIndex := bar_index
    stdvCustomSession3stdvs      := array.new_float(CustomSession3StdevNmbr * 4)
    stdvCustomSession3stdvsLines := array.new_line(CustomSession3StdevNmbr * 4)    
else if inCustomSession3
    CustomSession3HighPrice := math.max(CustomSession3HighPrice, high)
    CustomSession3LowPrice  := math.min(CustomSession3LowPrice, low)
    if session3CustomAnchored
        stdv1                   := (CustomSession3HighPrice - CustomSession3LowPrice)/2     
    else
        stdv1                   := CustomSession3HighPrice - CustomSession3LowPrice
    CustomSession3AvgPrice  := (CustomSession3HighPrice + CustomSession3LowPrice)/2

    if not session3CustomAnchored
        i = 0
        while i < CustomSession3StdevNmbr * 4
            if i == 0
                array.set(stdvCustomSession3stdvs, i, CustomSession3HighPrice + stdv1/2)
                array.set(stdvCustomSession3stdvs, i + 1, CustomSession3HighPrice + stdv1)
                array.set(stdvCustomSession3stdvs, i + 2, CustomSession3LowPrice - stdv1/2)
                array.set(stdvCustomSession3stdvs, i + 3, CustomSession3LowPrice - stdv1)
            else
                array.set(stdvCustomSession3stdvs, i, array.get(stdvCustomSession3stdvs,i-4) + stdv1)
                array.set(stdvCustomSession3stdvs, i + 1, array.get(stdvCustomSession3stdvs,i-3) + stdv1)
                array.set(stdvCustomSession3stdvs, i + 2, array.get(stdvCustomSession3stdvs,i-2) - stdv1)
                array.set(stdvCustomSession3stdvs, i + 3, array.get(stdvCustomSession3stdvs,i-1) - stdv1)
            i += 4

if CustomSession3Start and showCustomSession3
    CustomSession3Box := box.new(left=bar_index, top=na, right=na, bottom=na,border_width=CustomSession3BorderSize)
   
    if not session3CustomAnchored
        for i = 0 to array.size(stdvCustomSession3stdvsLines) - 1
            array.set(stdvCustomSession3stdvsLines, i,line.new(bar_index,array.get(stdvCustomSession3stdvs,i),bar_index+1,array.get(stdvCustomSession3stdvs,i),color =  CustomSession3BorderColor))
    

if inCustomSession3 and showCustomSession3 
    box.set_top(CustomSession3Box, CustomSession3HighPrice)
    box.set_bottom(CustomSession3Box, CustomSession3LowPrice)

    box.set_right(CustomSession3Box, bar_index + 1)

    box.set_bgcolor(CustomSession3Box, CustomSession3BgColor)
    box.set_border_color(CustomSession3Box, CustomSession3BorderColor)

    if not session3CustomAnchored
        for i = 0 to array.size(stdvCustomSession3stdvsLines) - 1
            if i % 2 == 0
                if(showCustomSession3Midlvl)
                    line.set_xy1(array.get(stdvCustomSession3stdvsLines,i), (bar_index + firstIndex)  /2 - 1 ,  array.get(stdvCustomSession3stdvs,i))
                    line.set_xy2(array.get(stdvCustomSession3stdvsLines,i), (bar_index + firstIndex)  /2 + 1, array.get(stdvCustomSession3stdvs,i) )
            else
                line.set_y1(array.get(stdvCustomSession3stdvsLines,i),  array.get(stdvCustomSession3stdvs,i))
                line.set_xy2(array.get(stdvCustomSession3stdvsLines,i), bar_index + 1, array.get(stdvCustomSession3stdvs,i) )


inCustomSession3Anchor    = InSession(CustomSession3AchorTime, timezone) and timeframe.isintraday
CustomSession3AnchorStart = inCustomSession3Anchor and not inCustomSession3Anchor[1]

if CustomSession3AnchorStart and session3CustomAnchored
    CustomSession3AnchorOpenPrice := open
    firstIndex := bar_index
    for i = 0 to array.size(stdvCustomSession3stdvsLines) - 1
        array.set(stdvCustomSession3stdvsLines, i,line.new(bar_index,array.get(stdvCustomSession3stdvs,i),bar_index+1,array.get(stdvCustomSession3stdvs,i),color =  CustomSession3BorderColor))


if inCustomSession3Anchor and session3CustomAnchored and showCustomSession3
    i = 0
    while i < CustomSession3StdevNmbr * 4
        if i == 0
            array.set(stdvCustomSession3stdvs, i, CustomSession3AnchorOpenPrice + stdv1/2)
            array.set(stdvCustomSession3stdvs, i + 1, CustomSession3AnchorOpenPrice + stdv1)
            array.set(stdvCustomSession3stdvs, i + 2, CustomSession3AnchorOpenPrice - stdv1/2)
            array.set(stdvCustomSession3stdvs, i + 3, CustomSession3AnchorOpenPrice - stdv1)
        else
            array.set(stdvCustomSession3stdvs, i, array.get(stdvCustomSession3stdvs,i-4) + stdv1)
            array.set(stdvCustomSession3stdvs, i + 1, array.get(stdvCustomSession3stdvs,i-3) + stdv1)
            array.set(stdvCustomSession3stdvs, i + 2, array.get(stdvCustomSession3stdvs,i-2) - stdv1)
            array.set(stdvCustomSession3stdvs, i + 3, array.get(stdvCustomSession3stdvs,i-1) - stdv1)
        i += 4

    for c = 0 to array.size(stdvCustomSession3stdvsLines) - 1
        if c % 2 == 0
            if(showCustomSession3Midlvl)
                line.set_xy1(array.get(stdvCustomSession3stdvsLines,c), (bar_index + firstIndex)  /2 - 1 ,  array.get(stdvCustomSession3stdvs,c))
                line.set_xy2(array.get(stdvCustomSession3stdvsLines,c), (bar_index + firstIndex)  /2 + 1, array.get(stdvCustomSession3stdvs,c) )
        else
            line.set_y1(array.get(stdvCustomSession3stdvsLines,c),  array.get(stdvCustomSession3stdvs,c))
            line.set_xy2(array.get(stdvCustomSession3stdvsLines,c), bar_index + 1, array.get(stdvCustomSession3stdvs,c) )


showRealGap            = input.bool(false,"Identify real FYB Gap")
realGapBoxBorderSize   = input.int(1, title="Real Gap Box border size", minval=0)
realGapBoxBgColor      = input.color(color.new(color.rgb(248,248,242), 85), title="Real Gap Box Background Color")
realGapBoxBorderColor  = input.color(color.rgb(248,248,242), title="Real Gap Box border Color")

if showRealGap
    fourPM2fourPM = "1600-1630"
    dailyTradingHrs = "0400-1559"
    
    // var fourPM2fourPMOpeningPrice = 0.0
    var TradingHrsLow = 0.0
    var TradingHrsHigh = 0.0
    var TradingHrsOpeningPrice = 0.0
    var box realGapBox = na
    // var anchorTime  = 0
    var TradingHrsTS = 0

   

    infourPM2fourPM    = InSession(fourPM2fourPM, timezone) and timeframe.isintraday
    fourPM2fourPMStart = infourPM2fourPM and not infourPM2fourPM[1]

    inTradingHours = InSession(dailyTradingHrs, timezone) and timeframe.isintraday
    inTradingHoursStart = inTradingHours and not inTradingHours[1]
       
    if inTradingHoursStart
        TradingHrsLow := low
        TradingHrsHigh := high
        TradingHrsOpeningPrice := open
        TradingHrsTS := time

    if inTradingHours
        TradingHrsHigh := math.max(TradingHrsHigh, high)
        TradingHrsLow  := math.min(TradingHrsLow, low)

    if TradingHrsOpeningPrice < TradingHrsLow[1] or TradingHrsOpeningPrice > TradingHrsHigh[1] 
        boxStartTS = timestamp(timezone, year(TradingHrsTS[1]),month(TradingHrsTS[1]),dayofmonth(TradingHrsTS[1]),16,00)
        
        realGapBox := box.new(left=boxStartTS,right = time, top=na, bottom=na, border_width=realGapBoxBorderSize, bgcolor = realGapBoxBgColor, border_color = realGapBoxBorderColor, xloc=xloc.bar_time)

        // box.set_right(realGapBox, time)
        // box.set_left(realGapBox,boxStartTS)

    if TradingHrsOpeningPrice < TradingHrsLow[1]
        box.set_top(realGapBox, TradingHrsLow[1])
        box.set_bottom(realGapBox, TradingHrsOpeningPrice )
    
    if TradingHrsOpeningPrice > TradingHrsHigh[1]
        box.set_top(realGapBox, TradingHrsOpeningPrice)
        box.set_bottom(realGapBox, TradingHrsHigh[1] )

// =============================================================================
// TARGET HIT DETECTION AND ALERTS (CORRECTED LOGIC)
// =============================================================================
// BULLISH: Long targets = aim for them, Short T2 = buy the dip (SCALP LONG)
// BEARISH: Short targets = aim for them, Long T2 = fade rally (SCALP SHORT)
// After T2 target hit: mean reversion scalp opportunity in opposite direction

// Track targets using previous day's SR levels (always available after first session)
if prevDaySRHigh > 0

    // Long T1 - only alert if bullish (target we're aiming for)
    // DISABLED: Only firing alerts at T2 (1.5 STD or above)
    if not longT1Hit and high >= longT1Price
        longT1Hit := true
        // if alertTargetHitEnabled and buying == true
        //     alert('{"content": "TCM Long T1 (' + str.tostring(target1STDMultiplier) + 'STD) HIT @ ' + str.tostring(longT1Price, "#.##") + '"}', alert.freq_once_per_bar)

    // Long T2 - BULLISH: target reached (can scalp short) | BEARISH: reversal zone (SCALP SHORT)
    if not longT2Hit and high >= longT2Price
        longT2Hit := true
        if alertTargetHitEnabled
            if buying == true
                alert('{"content": "🟢 ' + syminfo.ticker + ' LONG T2 HIT (' + str.tostring(target2STDMultiplier) + ' STD) @ ' + str.tostring(longT2Price, "#.##") + ' → SCALP SHORT (mean reversion)"}', alert.freq_once_per_bar)
            else if buying == false
                alert('{"content": "🔴 ' + syminfo.ticker + ' MAX HIGH (' + str.tostring(target2STDMultiplier) + ' STD) @ ' + str.tostring(longT2Price, "#.##") + ' → LOOK FOR SHORT (fade rally)"}', alert.freq_once_per_bar)

    // Short T1 - only alert if bearish (target we're aiming for)
    // DISABLED: Only firing alerts at T2 (1.5 STD or above)
    if not shortT1Hit and low <= shortT1Price
        shortT1Hit := true
        // if alertTargetHitEnabled and buying == false
        //     alert('{"content": "TCM Short T1 (' + str.tostring(target1STDMultiplier) + 'STD) HIT @ ' + str.tostring(shortT1Price, "#.##") + '"}', alert.freq_once_per_bar)

    // Short T2 - BEARISH: target reached (can scalp long) | BULLISH: reversal zone (SCALP LONG)
    if not shortT2Hit and low <= shortT2Price
        shortT2Hit := true
        if alertTargetHitEnabled
            if buying == false
                alert('{"content": "🔴 ' + syminfo.ticker + ' SHORT T2 HIT (' + str.tostring(target2STDMultiplier) + ' STD) @ ' + str.tostring(shortT2Price, "#.##") + ' → SCALP LONG (mean reversion)"}', alert.freq_once_per_bar)
            else if buying == true
                alert('{"content": "🟢 ' + syminfo.ticker + ' MAX LOW (' + str.tostring(target2STDMultiplier) + ' STD) @ ' + str.tostring(shortT2Price, "#.##") + ' → LOOK FOR LONG (buy the dip)"}', alert.freq_once_per_bar)

// =============================================================================
// 7:00 AM SR LEVELS ALERT (or manual test)
// =============================================================================
sevenAMAlertTime = "0700-0705"
inSevenAMAlert = InSession(sevenAMAlertTime, timezone) and timeframe.isintraday
sevenAMAlertStart = inSevenAMAlert and not inSevenAMAlert[1]

// Trigger on scheduled time OR manual test (on confirmed bar)
triggerLevelsAlert = (sevenAMAlertStart and alertSRLevelsEnabled and not alertedSRLevels) or (testSendLevels and barstate.isconfirmed)

// For testing: use current SR if previous day not available
testSRHigh = prevDaySRHigh > 0 ? prevDaySRHigh : ONsessionHighPrice
testSRLow = prevDaySRLow > 0 ? prevDaySRLow : ONsessionLowPrice
testSRRange = prevDaySRRange > 0 ? prevDaySRRange : ONSessionPipCount
hasSRData = testSRHigh > 0

// Recalculate targets for test mode if using current SR
testLongT1 = testSRHigh + ((testSRHigh - testSRLow) * target1STDMultiplier)
testLongT2 = testSRHigh + ((testSRHigh - testSRLow) * target2STDMultiplier)
testShortT1 = testSRLow - ((testSRHigh - testSRLow) * target1STDMultiplier)
testShortT2 = testSRLow - ((testSRHigh - testSRLow) * target2STDMultiplier)

if triggerLevelsAlert and hasSRData
    if not testSendLevels
        alertedSRLevels := true

    // Emojis for Discord
    biasIcon = buying ? "🟢" : "🔴"
    biasArrow = buying ? "▲" : "▼"
    biasText = buying ? "BULLISH" : "BEARISH"
    testPrefix = testSendLevels ? "🧪 [TEST] " : ""
    srSource = (prevDaySRHigh > 0) ? "" : " (using current SR)"

    msg = testPrefix + biasIcon + " " + ticker + " " + biasArrow + " " + biasText + srSource + "\\n"
    msg += "━━━━━━━━━━━━━━━━━━━━\\n"
    msg += "◾ **SR LEVELS**\\n"
    msg += "High: " + str.tostring(testSRHigh, "#.##") + "\\n"
    msg += "Low: " + str.tostring(testSRLow, "#.##") + "\\n"
    msg += "Range: " + str.tostring(testSRRange) + " pts\\n"
    msg += "━━━━━━━━━━━━━━━━━━━━\\n"

    // Show targets based on bias direction
    if buying
        msg += "◾ **TARGETS (LONG)**\\n"
        msg += "T1 (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(testLongT1, "#.##") + "\\n"
        msg += "T2 (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(testLongT2, "#.##") + "\\n"
        msg += "━━━━━━━━━━━━━━━━━━━━\\n"
        msg += "◾ **REVERSAL ZONE**\\n"
        msg += "MAX Low (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(testShortT1, "#.##") + "\\n"
        msg += "MAX Low (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(testShortT2, "#.##") + " → SCALP LONG"
    else
        msg += "◾ **TARGETS (SHORT)**\\n"
        msg += "T1 (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(testShortT1, "#.##") + "\\n"
        msg += "T2 (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(testShortT2, "#.##") + "\\n"
        msg += "━━━━━━━━━━━━━━━━━━━━\\n"
        msg += "◾ **REVERSAL ZONE**\\n"
        msg += "MAX High (" + str.tostring(target1STDMultiplier) + " STD): " + str.tostring(testLongT1, "#.##") + "\\n"
        msg += "MAX High (" + str.tostring(target2STDMultiplier) + " STD): " + str.tostring(testLongT2, "#.##") + " → SCALP SHORT"

    // Wrap in Discord JSON format
    jsonMsg = '{"content": "' + msg + '"}'
    alert(jsonMsg, alert.freq_once_per_bar)

// =============================================================================
// 9:20 AM SUMMARY ALERT (or manual test)
// =============================================================================
summaryAlertTime = "0920-0925"
inSummaryAlert = InSession(summaryAlertTime, timezone) and timeframe.isintraday
summaryAlertStart = inSummaryAlert and not inSummaryAlert[1]

// Trigger on scheduled time OR manual test (on confirmed bar)
triggerSummaryAlert = (summaryAlertStart and alertSummaryEnabled and not alertedSummary) or (testSendSummary and barstate.isconfirmed)

if triggerSummaryAlert and prevDaySRHigh > 0
    if not testSendSummary
        alertedSummary := true

    // Emojis for Discord
    biasIcon2 = buying ? "🟢" : "🔴"
    biasArrow2 = buying ? "▲" : "▼"
    biasText2 = buying ? "BULLISH" : "BEARISH"
    testPrefix2 = testSendSummary ? "🧪 [TEST] " : ""

    msg2 = testPrefix2 + biasIcon2 + " " + ticker + " " + biasArrow2 + " " + biasText2 + "\\n"
    msg2 += "━━━━━━━━━━━━━━━━━━━━\\n"
    msg2 += "◾ **9:20 AM SUMMARY**\\n"

    // Show status based on bias direction
    if buying
        longT1Status = longT1Hit ? "✅ HIT" : "⬜ NOT HIT"
        longT2Status = longT2Hit ? "✅ HIT" : "⬜ NOT HIT"
        shortT1Status = shortT1Hit ? "✅ HIT" : "⬜ NOT HIT"
        shortT2Status = shortT2Hit ? "✅ HIT" : "⬜ NOT HIT"

        msg2 += "**Primary Targets (Long)**\\n"
        msg2 += "T1 (" + str.tostring(target1STDMultiplier) + " STD): " + longT1Status + "\\n"
        msg2 += "T2 (" + str.tostring(target2STDMultiplier) + " STD): " + longT2Status
        if longT2Hit
            msg2 += " → SCALP SHORT"
        msg2 += "\\n"
        msg2 += "━━━━━━━━━━━━━━━━━━━━\\n"
        msg2 += "**Reversal Zone**\\n"
        msg2 += "MAX Low (" + str.tostring(target1STDMultiplier) + " STD): " + shortT1Status + "\\n"
        msg2 += "MAX Low (" + str.tostring(target2STDMultiplier) + " STD): " + shortT2Status
        if shortT2Hit
            msg2 += "\\n→ 🎯 SCALP LONG @ " + str.tostring(shortT2Price, "#.##")
    else
        shortT1Status = shortT1Hit ? "✅ HIT" : "⬜ NOT HIT"
        shortT2Status = shortT2Hit ? "✅ HIT" : "⬜ NOT HIT"
        longT1Status = longT1Hit ? "✅ HIT" : "⬜ NOT HIT"
        longT2Status = longT2Hit ? "✅ HIT" : "⬜ NOT HIT"

        msg2 += "**Primary Targets (Short)**\\n"
        msg2 += "T1 (" + str.tostring(target1STDMultiplier) + " STD): " + shortT1Status + "\\n"
        msg2 += "T2 (" + str.tostring(target2STDMultiplier) + " STD): " + shortT2Status
        if shortT2Hit
            msg2 += " → SCALP LONG"
        msg2 += "\\n"
        msg2 += "━━━━━━━━━━━━━━━━━━━━\\n"
        msg2 += "**Reversal Zone**\\n"
        msg2 += "MAX High (" + str.tostring(target1STDMultiplier) + " STD): " + longT1Status + "\\n"
        msg2 += "MAX High (" + str.tostring(target2STDMultiplier) + " STD): " + longT2Status
        if longT2Hit
            msg2 += "\\n→ 🎯 SCALP SHORT @ " + str.tostring(longT2Price, "#.##")

    // Wrap in Discord JSON format
    jsonMsg2 = '{"content": "' + msg2 + '"}'
    alert(jsonMsg2, alert.freq_once_per_bar)

// =============================================================================
// ALERT CONDITIONS (for right-click Add Alert menu)
// =============================================================================

// ALWAYS TRUE - This condition is true on EVERY bar, guaranteed to work
// Use this to test if alerts work at all
alertcondition(true, title="ALWAYS TRUE TEST", message='{"content": "ALWAYS TRUE - alerts working!"}')

// FORCE TEST - fires on EVERY bar while toggle is enabled (no conditions)
testForceCond = testForce
alertcondition(testForceCond, title="FORCE TEST (every bar)", message='{"content": "FORCE TEST - alerts working!"}')

// Test triggers (wait for bar close)
testSimpleCond = testSimple and barstate.isconfirmed
testLevelsCond = testSendLevels and barstate.isconfirmed
testSummaryCond = testSendSummary and barstate.isconfirmed
alertcondition(testSimpleCond, title="TEST Simple Ping", message='{"content": "TCM TEST PING"}')
alertcondition(testLevelsCond, title="TEST SR Levels", message='{"content": "Test SR Levels"}')
alertcondition(testSummaryCond, title="TEST Summary", message='{"content": "Test Summary"}')

// Scheduled alerts (use previous day SR)
amLevelsCond = sevenAMAlertStart and prevDaySRHigh > 0
amSummaryCond = summaryAlertStart and prevDaySRHigh > 0
alertcondition(amLevelsCond, title="7AM SR Levels", message="7AM Levels")
alertcondition(amSummaryCond, title="920 Summary", message="920 Summary")

// Target hit alerts
longT1Cond = longT1Hit and not longT1Hit[1]
longT2Cond = longT2Hit and not longT2Hit[1]
shortT1Cond = shortT1Hit and not shortT1Hit[1]
shortT2Cond = shortT2Hit and not shortT2Hit[1]
alertcondition(longT1Cond, title="Long T1 Hit", message="Long T1")
alertcondition(longT2Cond, title="Long T2 Hit", message="Long T2")
alertcondition(shortT1Cond, title="Short T1 Hit", message="Short T1")
alertcondition(shortT2Cond, title="Short T2 Hit", message="Short T2")

// Any alert
anyAlert = testLevelsCond or testSummaryCond or amLevelsCond or amSummaryCond
anyTarget = longT1Cond or longT2Cond or shortT1Cond or shortT2Cond
alertcondition(anyAlert or anyTarget, title="Any TCM Alert", message="TCM Alert")
