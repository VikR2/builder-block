f_strMid(_str, _from, _to) =>
    // string _str : source string.
    // int    _from: left character position. The first character's position is 0.
    // int    _to  : right character position.
    string[] _chars = str.split(_str, "")
    int _len = array.size(_chars)
    int _beg = math.min(_len - 1, math.max(0, _from))
    int _end = math.min(_len, math.max(0, _to + 1))
    string[] _substr = array.new_string(0)
    if _beg <= _end
        _substr := array.slice(_chars, _beg, _end)
    string _return = array.join(_substr, "")

f_strLeft(_str, _n) =>
    // string _str: source string.
    // int    _n  : number of leftmost characters to return.
    string[] _chars = str.split(_str, "")
    int _len = array.size(_chars)
    int _end = math.min(_len, math.max(0, _n))
    string[] _substr = array.new_string(0)
    if _end <= _len
        _substr := array.slice(_chars, 0, _end)
    string _return = array.join(_substr, "")

// Custom Opening Price

// CustomOpeningPriceA
showCustomOpeningPriceA = input.bool(true, "Show Custom Opening Price A")

customOpeningPriceA = input.session(defval="0920-1140", title="customOpeningPriceA")
customOpeningPriceAColor = input.color(#801922, "Custom Opening Price A color")


if showCustomOpeningPriceA

    var customOpeningPriceAOpeningPrice = 0.0
    var line customOpeningPriceAOpeningLine = na

    inCustomOpeningPriceA    = InSession(customOpeningPriceA, timezone) and timeframe.isintraday
    customOpeningPriceAStarts = inCustomOpeningPriceA and not inCustomOpeningPriceA[1]
    

    var lastopentime = 0
    var lastOpen1 = array.new_float(0)
    var lastTime1 = array.new_int(0)

    isInBefore = 0

    customHr1  = str.tonumber(f_strMid(customOpeningPriceA, 0, 1))
    customMin1 = str.tonumber(f_strMid(customOpeningPriceA, 2, 3))
    customHr2  = str.tonumber(f_strMid(customOpeningPriceA, 5, 6))
    customMin2 = str.tonumber(f_strMid(customOpeningPriceA, 7, 8))


    // if bar_index == last_bar_index
    //     l = label.new(bar_index, close, f_strMid(customOpeningPriceA, 7, 8))

    if customOpeningPriceAStarts 
        if array.size(lastOpen1) > 0
            for i = 0 to array.size(lastOpen1) - 1  
                if (array.get(lastTime1,i) == customMin1)
                    customOpeningPriceAOpeningPrice := array.get(lastOpen1,i)
                    isInBefore := 1
        if array.size(open1) > 0 and isInBefore == 0
            for i = 0 to array.size(open1) - 1
                if (array.get(time1,i) == customMin1)
                    customOpeningPriceAOpeningPrice := array.get(open1,i)
        
        tsStart = timestamp(timezone, year(lastopentime),month(lastopentime),dayofmonth(lastopentime),int(customHr1),int(customMin1))
        tsEnd := timestamp(timezone, year(time),month(time),dayofmonth(time),int(customHr2),int(customMin2))
        customOpeningPriceAOpeningLine := line.new(tsStart,customOpeningPriceAOpeningPrice,tsEnd,customOpeningPriceAOpeningPrice, xloc = xloc.bar_time)
        
        line.set_color(customOpeningPriceAOpeningLine, customOpeningPriceAColor)
        label.new(tsEnd-3000000, customOpeningPriceAOpeningPrice*0.99998, f_strMid(customOpeningPriceA, 0, 1) + ":" + f_strMid(customOpeningPriceA, 2, 3) , xloc = xloc.bar_time, style = label.style_none, textcolor = customOpeningPriceAColor, size = size.small, textalign = text.align_left)
            

    if lastopentime < time
        lastopentime := time
        lastOpen1 := open1
        lastTime1 := time1


