    inCustomOpeningPriceD    = InSession(CustomOpeningPriceD, timezone) and timeframe.isintraday
    CustomOpeningPriceDStarts = inCustomOpeningPriceD and not inCustomOpeningPriceD[1]
    

    var lastopentime = 0
    var lastOpen1 = array.new_float(0)
    var lastTime1 = array.new_int(0)

    isInBefore = 0

    customHr1  = str.tonumber(f_strMid(CustomOpeningPriceD, 0, 1))
    customMin1 = str.tonumber(f_strMid(CustomOpeningPriceD, 2, 3))
    customHr2  = str.tonumber(f_strMid(CustomOpeningPriceD, 5, 6))
    customMin2 = str.tonumber(f_strMid(CustomOpeningPriceD, 7, 8))


    // if bar_index == last_bar_index
    //     l = label.new(bar_index, close, f_strMid(CustomOpeningPriceD, 7, 8))

    if CustomOpeningPriceDStarts 
        if array.size(lastOpen1) > 0
            for i = 0 to array.size(lastOpen1) - 1  
                if (array.get(lastTime1,i) == customMin1)
                    CustomOpeningPriceDOpeningPrice := array.get(lastOpen1,i)
                    isInBefore := 1
        if array.size(open1) > 0 and isInBefore == 0
            for i = 0 to array.size(open1) - 1
                if (array.get(time1,i) == customMin1)
                    CustomOpeningPriceDOpeningPrice := array.get(open1,i)
        
        tsStart = timestamp(timezone, year(lastopentime),month(lastopentime),dayofmonth(lastopentime),int(customHr1),int(customMin1))
        tsEnd := timestamp(timezone, year(time),month(time),dayofmonth(time),int(customHr2),int(customMin2))
        CustomOpeningPriceDOpeningLine := line.new(tsStart,CustomOpeningPriceDOpeningPrice,tsEnd,CustomOpeningPriceDOpeningPrice, xloc = xloc.bar_time)
        
        line.set_color(CustomOpeningPriceDOpeningLine, CustomOpeningPriceDColor)
        label.new(tsEnd-3000000, CustomOpeningPriceDOpeningPrice*0.99998, f_strMid(CustomOpeningPriceD, 0, 1) + ":" + f_strMid(CustomOpeningPriceD, 2, 3) , xloc = xloc.bar_time, style = label.style_none, textcolor = CustomOpeningPriceDColor, size = size.small, textalign = text.align_left)
            

    if lastopentime < time
        lastopentime := time
        lastOpen1 := open1
        lastTime1 := time1


