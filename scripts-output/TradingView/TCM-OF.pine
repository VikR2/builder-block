// CustomTime 1


showCustomTime1 = input.bool(false, "Mark custom Time 1 with vertical Line")
CustomTime1 = input.session(defval="1117-1120", title="CustomTime1")
CustomTime1Color = input.color(color.rgb(0, 5, 3), "Custom time 1 color")

var showedCustomTime1Today = false

if showCustomTime1
    inCustomTime1    = InSession(CustomTime1, timezone) and timeframe.isintraday
    CustomTime1Start = inCustomTime1 and not inCustomTime1[1]

	
    customHr1  = int(str.tonumber(f_strMid(CustomTime1, 0, 1)))
    customMin1 = int(str.tonumber(f_strMid(CustomTime1, 2, 3)))

    tsStart = timestamp(timezone, year(time),month(time),dayofmonth(time),customHr1,customMin1)
    
    if not showedCustomTime1Today and timenow < tsStart
        tsStartNow = timestamp(timezone, year(timenow),month(timenow),dayofmonth(timenow),customHr1,customMin1) 
        CustomTime1linetoday = line.new(tsStartNow, close, tsStartNow, close * 1.01, xloc = xloc.bar_time, extend = extend.both, color = CustomTime1Color, style = line.style_dotted, width = 1)
        showedCustomTime1Today := true
    
    else if CustomTime1Start
        CustomTime1line = line.new(tsStart, close, tsStart, close * 1.01, xloc = xloc.bar_time, extend = extend.both, color = CustomTime1Color, style = line.style_dotted, width = 1)

