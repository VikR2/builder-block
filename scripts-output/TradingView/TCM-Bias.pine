//@version=5
indicator("TCM Bias Alerts", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
threshold = input.float(title="Price Difference Threshold", defval=0, step=0.001)
morningHour = input.int(title="Morning Report Hour (24h)", defval=7, minval=0, maxval=23)
morningMinute = input.int(title="Morning Report Minute", defval=0, minval=0, maxval=59)
marketCloseHour = input.int(title="Market Close Hour (24h)", defval=16, minval=0, maxval=23, tooltip="Bias change alerts only fire after this hour (default 4 PM = 16)")

// Manual Report - Push current bias to Discord on demand (same message as morning report)
sendReport = input.bool(title="📤 SEND: Daily Report Now", defval=false, group="Send Report Now", tooltip="Enable to send report now. Disable after sending.")

// Test Mode
testBiasChange = input.bool(title="🧪 TEST: Bias Change Alert", defval=false, group="Test Mode")

// ============================================================================
// BIAS CALCULATION
// ============================================================================
getDiff() =>
    yesterday = request.security(syminfo.tickerid, 'D', close[1], lookahead=barmerge.lookahead_on)
    today = request.security(syminfo.tickerid, 'D', close, lookahead=barmerge.lookahead_on)
    delta = today - yesterday
    percentage = delta / yesterday
    percentage

closeDiff = getDiff()

var bool buying = na
buying := closeDiff > threshold ? true : closeDiff < -threshold ? false : buying

// ============================================================================
// VISUAL DISPLAY
// ============================================================================
hline(0, title="Zero Line", color=color.gray)

bgColor = buying ? color.new(color.green, 75) : color.new(color.red, 75)
bgcolor(bgColor)

plot(closeDiff, color=color.new(color.silver, 25), style=plot.style_area, title="Area")
plot(closeDiff, color=color.aqua, title="Prediction", linewidth=2)

// ============================================================================
// BIAS CHANGE DETECTION (only during market hours, before 4 PM)
// ============================================================================
buyingChanged = ta.change(buying)
duringMarketHours = hour >= morningHour and hour < marketCloseHour
biasChangeDuringMarket = buyingChanged and duringMarketHours

// ============================================================================
// MORNING REPORT DETECTION (triggers once at specified time)
// ============================================================================
isMorningBar = hour == morningHour and minute >= morningMinute and minute < morningMinute + 5
morningReport = isMorningBar and not isMorningBar[1]

// ============================================================================
// MANUAL/TEST MODE TRIGGERS
// ============================================================================
triggerOnBar = barstate.isconfirmed

// ============================================================================
// DYNAMIC MESSAGE CONSTRUCTION
// ============================================================================
ticker = syminfo.ticker
biasEmoji = buying ? "🟢" : "🔴"
biasArrow = buying ? "▲" : "▼"
biasText = buying ? "BULLISH" : "BEARISH"

// Daily Report Message (JSON for Discord webhook)
dailyReportMsg = '{"content": "' + biasEmoji + ' ' + ticker + ' ' + biasArrow + ' Daily Bias: ' + biasText + '\\n◾ **MORNING BIAS REPORT**\\n**This is not an entry signal.** Make your own analysis.\\nTCM Bias v1.0 | ' + ticker + '"}'

// Bias Change Message (JSON for Discord webhook)
biasChangeMsg = '{"content": "' + biasEmoji + ' ' + ticker + ' ' + biasArrow + ' Daily Bias turned ' + biasText + '\\n◾ **BIAS CHANGE ALERT**\\nDaily momentum shift detected\\n**This is not an entry signal.** Make your own analysis.\\nTCM Bias v1.0 | ' + ticker + '"}'

// ============================================================================
// ALERTS - Using alert() for dynamic messages
// ============================================================================

// Daily Report Alert (7 AM scheduled or manual)
if (morningReport or (sendReport and triggerOnBar))
    alert(dailyReportMsg, alert.freq_once_per_bar)

// Bias Change Alert (only fires during market hours 7 AM - 4 PM)
if (biasChangeDuringMarket or (testBiasChange and triggerOnBar))
    alert(biasChangeMsg, alert.freq_once_per_bar)