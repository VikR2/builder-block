// --- Visual Settings ---
GRP_VISUAL = "Visual Settings"
showSignals = input.bool(true, "Show Entry Signals", group=GRP_VISUAL)
showZones = input.bool(true, "Show Zones", group=GRP_VISUAL)
showLevels = input.bool(true, "Show Entry/SL/TP Levels", group=GRP_VISUAL)
showDashboard = input.bool(true, "Show Dashboard", group=GRP_VISUAL)

// --- Color Settings ---
GRP_COLORS = "Colors"
bullishColor = input.color(color.new(#22C55E, 30), "Bullish Color", group=GRP_COLORS)
bearishColor = input.color(color.new(#EF4444, 30), "Bearish Color", group=GRP_COLORS)
neutralColor = input.color(color.new(#6B7280, 50), "Neutral Color", group=GRP_COLORS)

// ============================================================================
// COLOR SCHEME
// ============================================================================

// Zone fills (transparent)
var color BULLISH_ZONE_FILL = color.new(#22C55E, 85)
var color BEARISH_ZONE_FILL = color.new(#EF4444, 85)

// Signal colors
var color ENTRY_COLOR = color.new(#3B82F6, 30)
var color SL_COLOR = color.new(#EF4444, 30)
var color TP_COLOR = color.new(#22C55E, 30)

// Dashboard
var color DASH_BG = color.new(#1F2937, 10)
var color DASH_TEXT = color.new(#E5E7EB, 0)

// ============================================================================
// STATE VARIABLES
// ============================================================================

${STATE_VARIABLES}

// Signal tracking for cleanup
var array<label> signalLabels = array.new_label()
var array<box> signalBoxes = array.new_box()
var array<line> signalLines = array.new_line()

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Cleanup helpers
trackLabel(lbl) =>
    array.push(signalLabels, lbl)
    if array.size(signalLabels) > 50
        label.delete(array.shift(signalLabels))

trackBox(bx) =>
    array.push(signalBoxes, bx)
    if array.size(signalBoxes) > 50
        box.delete(array.shift(signalBoxes))

trackLine(ln) =>
    array.push(signalLines, ln)
    if array.size(signalLines) > 100
        line.delete(array.shift(signalLines))

// Time helpers
getBarHour() =>
    hour(time, "America/New_York")

getBarMinute() =>
    minute(time, "America/New_York")

isNewDay() =>
    ta.change(time("D")) != 0

${HELPER_FUNCTIONS}

