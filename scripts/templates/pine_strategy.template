//@version=6
// NOTE: v6 margin defaults changed - margin_long and margin_short now default to 100 (was 0 in v5)
strategy('${STRATEGY_NAME}', overlay=${OVERLAY}, initial_capital=${INITIAL_CAPITAL}, default_qty_type=strategy.percent_of_equity, default_qty_value=${QTY_PERCENT}, commission_type=strategy.commission.cash_per_contract, commission_value=${COMMISSION}, margin_long=100, margin_short=100)

// ============================================================================
// INPUT SETTINGS
// ============================================================================

// --- Time Settings ---
GRP_TIME = "Time Settings"
${TIME_INPUTS}

// --- Strategy Settings ---
GRP_STRATEGY = "Strategy Settings"
${STRATEGY_INPUTS}

// --- Risk Management ---
GRP_RISK = "Risk Management"
riskPercent = input.float(1.0, "Risk Per Trade %", minval=0.1, maxval=10, step=0.1, group=GRP_RISK)
rrRatio = input.float(2.0, "Risk:Reward Ratio", minval=0.5, maxval=10, step=0.1, group=GRP_RISK)
useTrailingStop = input.bool(false, "Use Trailing Stop", group=GRP_RISK)
trailPercent = input.float(1.0, "Trail %", minval=0.1, maxval=5, step=0.1, group=GRP_RISK)

// --- Visual Settings ---
GRP_VISUAL = "Visual Settings"
showSignals = input.bool(true, "Show Entry Signals", group=GRP_VISUAL)
showZones = input.bool(true, "Show Zones", group=GRP_VISUAL)
showLevels = input.bool(true, "Show Entry/SL/TP Levels", group=GRP_VISUAL)
showDashboard = input.bool(true, "Show Dashboard", group=GRP_VISUAL)

// --- Color Settings ---
GRP_COLORS = "Colors"
bullishColor = input.color(color.new(#22C55E, 30), "Bullish Color", group=GRP_COLORS)
bearishColor = input.color(color.new(#EF4444, 30), "Bearish Color", group=GRP_COLORS)

// ============================================================================
// COLOR SCHEME
// ============================================================================

var color BULLISH_ZONE_FILL = color.new(#22C55E, 85)
var color BEARISH_ZONE_FILL = color.new(#EF4444, 85)
var color ENTRY_COLOR = color.new(#3B82F6, 30)
var color SL_COLOR = color.new(#EF4444, 30)
var color TP_COLOR = color.new(#22C55E, 30)
var color DASH_BG = color.new(#1F2937, 10)
var color DASH_TEXT = color.new(#E5E7EB, 0)

// ============================================================================
// STATE VARIABLES
// ============================================================================

${STATE_VARIABLES}

// Position tracking
var float entryPrice = na
var float stopLoss = na
var float takeProfit = na
var int tradeDirection = 0  // 1=long, -1=short, 0=flat

// Signal tracking for cleanup
var array<label> signalLabels = array.new_label()
var array<box> signalBoxes = array.new_box()
var array<line> signalLines = array.new_line()

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

trackLabel(lbl) =>
    array.push(signalLabels, lbl)
    if array.size(signalLabels) > 50
        label.delete(array.shift(signalLabels))

trackBox(bx) =>
    array.push(signalBoxes, bx)
    if array.size(signalBoxes) > 50
        box.delete(array.shift(signalBoxes))

trackLine(ln) =>
    array.push(signalLines, ln)
    if array.size(signalLines) > 100
        line.delete(array.shift(signalLines))

getBarHour() =>
    hour(time, "America/New_York")

getBarMinute() =>
    minute(time, "America/New_York")

isNewDay() =>
    ta.change(time("D")) != 0

// Position size calculation
calcPositionSize(entryPx, stopPx) =>
    riskAmount = strategy.equity * (riskPercent / 100)
    riskPerUnit = math.abs(entryPx - stopPx)
    riskPerUnit > 0 ? math.floor(riskAmount / riskPerUnit) : 0

${HELPER_FUNCTIONS}

// ============================================================================
// DAILY RESET
// ============================================================================

if isNewDay()
    ${DAILY_RESET}

// ============================================================================
// MAIN LOGIC
// ============================================================================

${MAIN_LOGIC}

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

${ENTRY_CONDITIONS}

// Entry logic
longCondition = ${LONG_CONDITION}
shortCondition = ${SHORT_CONDITION}

// ============================================================================
// TRADE EXECUTION
// ============================================================================

if longCondition and strategy.position_size == 0
    entryPrice := close
    stopLoss := ${LONG_STOP}
    takeProfit := entryPrice + (entryPrice - stopLoss) * rrRatio
    tradeDirection := 1

    qty = calcPositionSize(entryPrice, stopLoss)
    if qty > 0
        strategy.entry("Long", strategy.long, qty=qty)
        strategy.exit("Long Exit", "Long", stop=stopLoss, limit=takeProfit)

if shortCondition and strategy.position_size == 0
    entryPrice := close
    stopLoss := ${SHORT_STOP}
    takeProfit := entryPrice - (stopLoss - entryPrice) * rrRatio
    tradeDirection := -1

    qty = calcPositionSize(entryPrice, stopLoss)
    if qty > 0
        strategy.entry("Short", strategy.short, qty=qty)
        strategy.exit("Short Exit", "Short", stop=stopLoss, limit=takeProfit)

// Trailing stop
if useTrailingStop and strategy.position_size != 0
    if tradeDirection == 1
        strategy.exit("Trail Long", "Long", trail_price=close * (1 - trailPercent/100), trail_offset=0)
    else if tradeDirection == -1
        strategy.exit("Trail Short", "Short", trail_price=close * (1 + trailPercent/100), trail_offset=0)

// Reset on position close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    entryPrice := na
    stopLoss := na
    takeProfit := na
    tradeDirection := 0

// ============================================================================
// VISUALIZATION
// ============================================================================

if showSignals
    ${SIGNAL_VISUALIZATION}

if showZones
    ${ZONE_VISUALIZATION}

if showLevels and strategy.position_size != 0
    // Entry line
    line.new(bar_index[1], entryPrice, bar_index, entryPrice, color=ENTRY_COLOR, width=2)
    // Stop line
    line.new(bar_index[1], stopLoss, bar_index, stopLoss, color=SL_COLOR, width=2, style=line.style_dashed)
    // TP line
    line.new(bar_index[1], takeProfit, bar_index, takeProfit, color=TP_COLOR, width=2, style=line.style_dashed)

// ============================================================================
// DASHBOARD
// ============================================================================

if showDashboard and barstate.islast
    var table dashTable = table.new(position.top_right, 2, 6, DASH_BG, color.gray, 1, color.gray, 1)

    table.cell(dashTable, 0, 0, "Strategy", text_color=DASH_TEXT, text_halign=text.align_left)
    table.cell(dashTable, 1, 0, "${STRATEGY_NAME}", text_color=DASH_TEXT, text_halign=text.align_right)

    table.cell(dashTable, 0, 1, "Position", text_color=DASH_TEXT, text_halign=text.align_left)
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posColor = strategy.position_size > 0 ? bullishColor : strategy.position_size < 0 ? bearishColor : DASH_TEXT
    table.cell(dashTable, 1, 1, posText, text_color=posColor, text_halign=text.align_right)

    table.cell(dashTable, 0, 2, "Entry", text_color=DASH_TEXT, text_halign=text.align_left)
    table.cell(dashTable, 1, 2, na(entryPrice) ? "-" : str.tostring(entryPrice, format.mintick), text_color=DASH_TEXT, text_halign=text.align_right)

    table.cell(dashTable, 0, 3, "Stop", text_color=DASH_TEXT, text_halign=text.align_left)
    table.cell(dashTable, 1, 3, na(stopLoss) ? "-" : str.tostring(stopLoss, format.mintick), text_color=SL_COLOR, text_halign=text.align_right)

    table.cell(dashTable, 0, 4, "Target", text_color=DASH_TEXT, text_halign=text.align_left)
    table.cell(dashTable, 1, 4, na(takeProfit) ? "-" : str.tostring(takeProfit, format.mintick), text_color=TP_COLOR, text_halign=text.align_right)

    table.cell(dashTable, 0, 5, "Win Rate", text_color=DASH_TEXT, text_halign=text.align_left)
    winRate = strategy.wintrades / math.max(strategy.closedtrades, 1) * 100
    table.cell(dashTable, 1, 5, str.tostring(winRate, "#.#") + "%", text_color=DASH_TEXT, text_halign=text.align_right)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longCondition, title="Long Signal", message="Long entry signal triggered")
alertcondition(shortCondition, title="Short Signal", message="Short entry signal triggered")

${ALERTS}
