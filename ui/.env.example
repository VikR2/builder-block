# Copy this file to `.env.local` for local development.
# Use Stripe test-mode values locally. Put live values only in Render environment variables.

# Local app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe test mode
# Get these from Stripe Dashboard -> Developers -> API keys while Test mode is on.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe test-mode $25/month price
# Get this from Stripe Dashboard -> Product catalog -> your test subscription price.
STRIPE_PRICE_ID=price_replace_me

# Local webhook secret
# If using Stripe CLI: `stripe listen --forward-to localhost:3000/api/stripe/webhooks`
# If manually replaying signed local test events, use the same value in your signer.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional email settings for auth/welcome emails
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI chat settings
TCM_LLM_PROVIDER=
TCM_CHAT_MODEL=
TCM_CHAT_TIMEOUT_MS=15000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Render production uses the same variable names, but values should be:
# NEXT_PUBLIC_APP_URL=https://thecurrencymerchant.com
# NEXT_PUBLIC_BASE_URL=https://thecurrencymerchant.com
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
